# apps/api/.env — NestJS + Prisma
# Reconstituer les valeurs depuis le tableau de bord Supabase (bouton "Connect").
# Ne JAMAIS committer apps/api/.env (déjà couvert par .gitignore).

# --- Prisma → Postgres Supabase -------------------------------------------------
# Onglet Connect → ORM → Prisma
# DATABASE_URL : connexion "pooler" (port 6543, pgbouncer) pour l'appli
DATABASE_URL="postgresql://postgres.untipyycbhllqxwpucml:MOT_DE_PASSE@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL : connexion directe (port 5432) utilisée par prisma migrate / db pull
DIRECT_URL="postgresql://postgres.untipyycbhllqxwpucml:MOT_DE_PASSE@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Authentification : validation JWT via JWKS (signature asymétrique ECC P-256)
# URL publique (200 sans apikey) — PAS de secret partagé. SUPABASE_JWT_SECRET n'existe pas ici.
# Endpoint = .well-known/jwks.json (le chemin /auth/v1/jwks renvoie 401 : il n'existe pas).
SUPABASE_JWKS_URL="https://untipyycbhllqxwpucml.supabase.co/auth/v1/.well-known/jwks.json"
# Issuer attendu dans le token (claim "iss")
SUPABASE_JWT_ISSUER="https://untipyycbhllqxwpucml.supabase.co/auth/v1"
# Audience attendue dans le token (claim "aud") — "authenticated" par défaut sur Supabase
SUPABASE_JWT_AUDIENCE="authenticated"

# --- Appels API Admin Supabase (invitations, Storage cartes, etc. — serveur) --
SUPABASE_URL="https://untipyycbhllqxwpucml.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."  # SECRÈTE — jamais exposée au navigateur
# Durée de vie (s) des URL signées des cartes de membre (bucket privé `cartes`, défaut 3600)
# CARTE_URL_TTL_SECONDS="3600"

# --- Microservice Java d'adjudication (adjudication-service/) -----------------
# URL du microservice appelé après verrouillage d'une réclamation (POST .../evaluer)
ADJUDICATION_SERVICE_URL="http://localhost:8899"
# Secret HMAC-SHA256 du JWT de service — DOIT être IDENTIQUE à adjudication-service/.env
# OBLIGATOIRE : apps/api REFUSE de démarrer si cette variable est absente ou vide
# (main.ts → verifierSecretsObligatoires) — évite un 401 silencieux au 1er appel.
SERVICE_JWT_SECRET=""
# Timeout (ms) de l'appel HTTP au microservice (défaut 12000)
# ADJUDICATION_TIMEOUT_MS="12000"
# Délai de la sonde de santé du microservice (GET /readyz, utilisée par GET /api/v1/sante).
# ADJUDICATION_SANTE_TIMEOUT_MS="3000"

# --- Géocodage du réseau de soins (Nominatim / OpenStreetMap) ----------------
# Résolution automatique adresse -> coordonnées à la création d'un établissement
# ou d'une pharmacie. Un seul appel par création (politique d'usage Nominatim).
# NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
# User-Agent OBLIGATOIRE côté Nominatim — identifie l'application (mettez un contact réel).
# NOMINATIM_USER_AGENT="assurance-sante-core-system/1.0 (contact: ops@votre-domaine.ci)"
# NOMINATIM_TIMEOUT_MS="5000"

# --- Divers ------------------------------------------------------------------
# URL publique du frontend Next.js — lien d'acceptation d'invitation (redirect_to).
WEB_URL="http://localhost:3000"
PORT=3001

# --- E-mails (Resend) ----------------------------------------------------------
# Clé API Resend. Absente : les e-mails sont journalisés mais pas envoyés.
RESEND_API_KEY=
# Destinataire des formulaires de la page d'accueil (Contact, Devenir partenaire,
# Adhésion). En bac à sable Resend (expéditeur onboarding@resend.dev), seule
# l'adresse du compte Resend reçoit les e-mails.
CONTACT_EMAIL=

# Organisation dont les événements actifs sont publiés dans le carrousel de la
# page d'accueil (GET /api/v1/public/evenements). Absente ou invalide : aucun
# événement public. La RLS de la table `evenements` lit la même organisation
# dans parametres_plateforme (cle = 'vitrine_organisation_id', valeur "uuid") :
# renseigner les deux avec le même identifiant (prisma/sql/060).
VITRINE_ORGANISATION_ID=
