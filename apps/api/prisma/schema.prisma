  motif              String?
  observations       String?
  diagnostic         String?
  codeCim10          String?   @map("code_cim10")
  statut             String    @default("EN_COURS") // EN_COURS | TERMINEE | ANNULEE
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  dossier     DossierSoins  @relation(fields: [dossierSoinsId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  medecin     Profil        @relation(fields: [medecinId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordonnances Ordonnance[]
  actes       ActeDossier[]

  @@index([dossierSoinsId])
  @@index([medecinId])
  @@map("consultations_dossier")
}

/// codes_consultation — 1er des 4 codes anti-fraude (v8 §2). Généré côté serveur,
/// envoyé à l'adhérent, saisi par l'établissement. Sa validation est la SEULE
/// voie d'ouverture d'un dossier de soins. prisma/sql/012.
model CodeConsultation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String   @map("organisation_id") @db.Uuid
  adherentId      String?  @map("adherent_id") @db.Uuid
  beneficiaireId  String?  @map("beneficiaire_id") @db.Uuid
  etablissementId String   @map("etablissement_id") @db.Uuid
  policeId        String   @map("police_id") @db.Uuid
  code            String   @unique
  dateEmission    DateTime @default(now()) @map("date_emission") @db.Timestamptz(6)
  dateExpiration  DateTime @default(dbgenerated("(now() + '48:00:00'::interval)")) @map("date_expiration") @db.Timestamptz(6)
  statut          String   @default("EMIS") // EMIS | CONFIRME_PATIENT | UTILISE_ETABLISSEMENT | EXPIRE | ANNULE
  canalEnvoi      String[] @default(["APP", "SMS"]) @map("canal_envoi")
  dossierSoinsId  String?  @map("dossier_soins_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation  Organisation       @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  etablissement EtablissementSante @relation(fields: [etablissementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  police        Police             @relation(fields: [policeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dossier       DossierSoins?      @relation(fields: [dossierSoinsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adherent      Adherent?          @relation(fields: [adherentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  beneficiaire  Beneficiaire?      @relation(fields: [beneficiaireId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organisationId])
  @@index([adherentId])
  @@index([etablissementId])
  @@index([statut])
  @@map("codes_consultation")
}

/// ordonnances — table minimale (v8 §3, PROMPT 19). `lignes` = liste JSON de
/// médicaments/posologie ; le référentiel `medicaments` viendra l'affiner.
/// prisma/sql/013.
model Ordonnance {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  dossierSoinsId   String    @map("dossier_soins_id") @db.Uuid
  consultationId   String    @map("consultation_id") @db.Uuid
  medecinId        String    @map("medecin_id") @db.Uuid
  lignes           Json      @default("[]")
  statut           String    @default("ACTIVE") // ACTIVE | PARTIELLEMENT_DELIVREE | COMPLETEMENT_DELIVREE | EXPIREE | ANNULEE
  datePrescription DateTime  @default(now()) @map("date_prescription") @db.Timestamptz(6)
  dateValidite     DateTime  @default(dbgenerated("(now() + '7 days'::interval)")) @map("date_validite") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dossier      DossierSoins        @relation(fields: [dossierSoinsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  consultation ConsultationDossier @relation(fields: [consultationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medecin      Profil              @relation(fields: [medecinId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  codes        CodeOrdonnance[]
  lignesOrdonnance LigneOrdonnance[]
  dispensationsPharmacie DispensationPharmacie[]

  @@index([organisationId])
  @@index([dossierSoinsId])
  @@index([consultationId])
  @@index([statut])
  @@map("ordonnances")
}

/// lignes_ordonnance — révision majeure (clarification métier) : remplace
/// `ordonnances.lignes` (jsonb) par une vraie table, pour un verrou PAR LIGNE
/// (pas par ordonnance entière comme au PROMPT 19). `statut` ne passe à SERVIE
/// qu'au règlement confirmé d'une dispensation (jamais à la préparation) —
/// voir `PharmacyService.confirmerPaiementDispensation`. prisma/sql/026.
model LigneOrdonnance {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ordonnanceId           String    @map("ordonnance_id") @db.Uuid
  denominationMedicament String    @map("denomination_medicament")
  dosage                 String?
  posologie              String
  duree                  String?
  quantitePrescrite      Int       @default(1) @map("quantite_prescrite")
  statut                 String    @default("DISPONIBLE") @map("statut") // DISPONIBLE | SERVIE
  pharmacieServanteId    String?   @map("pharmacie_servante_id") @db.Uuid
  quantiteServie         Int?      @map("quantite_servie")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ordonnance       Ordonnance          @relation(fields: [ordonnanceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pharmacieServante Pharmacie?         @relation(fields: [pharmacieServanteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lignesDispensation LigneDispensation[]

  @@index([ordonnanceId])
  @@index([statut])
  @@index([pharmacieServanteId])
  @@map("lignes_ordonnance")
}

/// stock_medicaments_pharmacie — chaque pharmacie fixe son propre prix par
/// dénomination (texte libre, pas de FK vers le référentiel national). Gap
/// documenté au prompt précédent, comblé ici. prisma/sql/026.
model StockMedicamentPharmacie {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pharmacieId            String   @map("pharmacie_id") @db.Uuid
  denominationMedicament String   @map("denomination_medicament")
  prixPharmacie          Decimal? @map("prix_pharmacie") @db.Decimal(14, 2)
  disponible             Boolean  @default(true)
  dateMaj                DateTime @default(now()) @map("date_maj") @db.Timestamptz(6)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pharmacie Pharmacie @relation(fields: [pharmacieId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([pharmacieId, denominationMedicament])
  @@index([pharmacieId])
  @@map("stock_medicaments_pharmacie")
}

/// dispensations_pharmacie — cycle de vie complet du nouveau flux pharmacie
/// (EN_PREPARATION → EN_ATTENTE_VALIDATION_PATIENT → VALIDEE → PAYEE), même
/// garde anti-fraude bloquante que les 4 codes déjà construits (v8) : paiement
/// impossible sans validation du code par le patient (trigger
/// verifier_dispensation_payable). prisma/sql/026.
model DispensationPharmacie {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ordonnanceId          String    @map("ordonnance_id") @db.Uuid
  pharmacieId           String    @map("pharmacie_id") @db.Uuid
  /// utilisateur ayant préparé la dispensation (n'importe lequel des 3
  /// sous-rôles PHARMACIE_*, nom de colonne conservé tel que spécifié).
  caissiereId           String    @map("caissiere_id") @db.Uuid
  montantTotal          Decimal   @default(0) @map("montant_total") @db.Decimal(14, 2)
  statut                String    @default("EN_PREPARATION") // EN_PREPARATION | EN_ATTENTE_VALIDATION_PATIENT | VALIDEE | PAYEE | ANNULEE
  codeConfirmation      String?   @unique @map("code_confirmation")
  datePreparation       DateTime  @default(now()) @map("date_preparation") @db.Timestamptz(6)
  dateValidationPatient DateTime? @map("date_validation_patient") @db.Timestamptz(6)
  datePaiement          DateTime? @map("date_paiement") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  ordonnance Ordonnance          @relation(fields: [ordonnanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pharmacie  Pharmacie           @relation(fields: [pharmacieId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  preparateur Profil             @relation(fields: [caissiereId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lignes     LigneDispensation[]

  @@index([ordonnanceId])
  @@index([pharmacieId])
  @@index([statut])
  @@map("dispensations_pharmacie")
}

model LigneDispensation {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dispensationId      String    @map("dispensation_id") @db.Uuid
  ligneOrdonnanceId   String    @map("ligne_ordonnance_id") @db.Uuid
  prixUnitaire        Decimal   @map("prix_unitaire") @db.Decimal(14, 2)
  quantite            Int       @default(1)
  montantLigne        Decimal   @map("montant_ligne") @db.Decimal(14, 2)
  /// substitution réservée au PHARMACIE_PHARMACIEN, avant confirmation du
  /// paiement uniquement (v. PharmacyService.substituerMedicament).
  medicamentSubstitue String?   @map("medicament_substitue")
  motifSubstitution   String?   @map("motif_substitution")
  substitueParId      String?   @map("substitue_par_id") @db.Uuid
  dateSubstitution    DateTime? @map("date_substitution") @db.Timestamptz(6)

  dispensation    DispensationPharmacie @relation(fields: [dispensationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ligneOrdonnance LigneOrdonnance       @relation(fields: [ligneOrdonnanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  substituePar    Profil?               @relation(fields: [substitueParId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([dispensationId])
  @@index([ligneOrdonnanceId])
  @@map("lignes_dispensation")
}

/// codes_ordonnance — 2e des 4 codes anti-fraude (v8 §3). Sa validation par une
/// pharmacie est le SEUL moment où le contenu de l'ordonnance lui est révélé.
/// prisma/sql/013.
model CodeOrdonnance {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId          String   @map("organisation_id") @db.Uuid
  ordonnanceId            String?  @map("ordonnance_id") @db.Uuid
  adherentId              String?  @map("adherent_id") @db.Uuid
  beneficiaireId          String?  @map("beneficiaire_id") @db.Uuid
  code                    String   @unique
  dateEmission            DateTime @default(now()) @map("date_emission") @db.Timestamptz(6)
  dateExpiration          DateTime @default(dbgenerated("(now() + '7 days'::interval)")) @map("date_expiration") @db.Timestamptz(6)
  statut                  String   @default("EMIS") // EMIS | PRESENTE_PHARMACIE | UTILISE_PARTIEL | UTILISE_COMPLET | EXPIRE | ANNULE
  pharmacieUtilisatriceId String?  @map("pharmacie_utilisatrice_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordonnance   Ordonnance?   @relation(fields: [ordonnanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pharmacie    Pharmacie?    @relation(fields: [pharmacieUtilisatriceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adherent     Adherent?     @relation(fields: [adherentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  beneficiaire Beneficiaire? @relation(fields: [beneficiaireId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organisationId])
  @@index([adherentId])
  @@index([ordonnanceId])
  @@index([statut])
  @@map("codes_ordonnance")
}

/// tickets_soins — 3e des 4 codes anti-fraude (v8 §4). Un seul ticket par
/// dossier de soins ; créé et clôturé AUTOMATIQUEMENT avec le dossier (jamais
/// une étape manuelle). Trigger `verifier_ticket_ouvert()`. prisma/sql/014.
model TicketSoins {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dossierSoinsId String    @unique @map("dossier_soins_id") @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  code           String    @unique
  dateEmission   DateTime  @default(now()) @map("date_emission") @db.Timestamptz(6)
  dateCloture    DateTime? @map("date_cloture") @db.Timestamptz(6)
  statut         String    @default("OUVERT") // OUVERT | CLOTURE | ANNULE
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  dossier      DossierSoins    @relation(fields: [dossierSoinsId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actes        ActeDossier[]
  facture      FactureDossier?

  @@index([statut])
  @@index([organisationId])
  @@map("tickets_soins")
}

/// actes_dossier — actes d'un épisode de soins (v1 §15). Rattachés à un
/// `ticket_soins` OUVERT (trigger). `medecin_prescripteur_id` = compte réel
/// (v10 §1.2). prisma/sql/014.
model ActeDossier {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dossierSoinsId        String    @map("dossier_soins_id") @db.Uuid
  ticketSoinsId         String    @map("ticket_soins_id") @db.Uuid
  consultationId        String?   @map("consultation_id") @db.Uuid
  medecinPrescripteurId String?   @map("medecin_prescripteur_id") @db.Uuid
  categorieActe         String    @map("categorie_acte")
  libelle               String
  codeActe              String?   @map("code_acte")
  quantite              Int       @default(1)
  montantPrescrit       Decimal?  @map("montant_prescrit") @db.Decimal(14, 2)
  /// Simulation INDICATIVE calculée à l'ajout de l'acte (tarif conventionné si
  /// applicable × taux de couverture de la garantie) — le calcul définitif de
  /// l'adjudication (microservice Java) garde le dernier mot. NULL si l'acte
  /// n'a pas de codeActe renseigné/homologué (rien à simuler). prisma/sql/037.
  montantSimuleAssurance Decimal? @map("montant_simule_assurance") @db.Decimal(14, 2)
  montantSimulePatient   Decimal? @map("montant_simule_patient") @db.Decimal(14, 2)
  ticketModerateurSimule Decimal? @map("ticket_moderateur_simule") @db.Decimal(14, 2)
  /// Pré-autorisation obligatoire pour les actes ANALYSES_EXAMENS_MEDICAUX —
  /// forcée à EN_ATTENTE_VALIDATION côté serveur (jamais par le client) quand
  /// dossier.typeVisite = ANALYSES_EXAMENS_MEDICAUX à l'ajout de l'acte. Tant
  /// qu'EN_ATTENTE_VALIDATION ou REFUSEE, l'acte est exclu de toute
  /// facturation/paiement (v3 §5 étendu). prisma/sql/038.
  statutPreautorisation String    @default("NON_REQUISE") @map("statut_preautorisation") // NON_REQUISE | EN_ATTENTE_VALIDATION | APPROUVEE | REFUSEE
  statut                String    @default("PRESCRIT") // PRESCRIT | REALISE | ANNULE | LIQUIDE
  datePrescription      DateTime  @default(now()) @map("date_prescription") @db.Timestamptz(6)
  dateRealisation       DateTime? @map("date_realisation") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  dossier      DossierSoins         @relation(fields: [dossierSoinsId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ticket       TicketSoins          @relation(fields: [ticketSoinsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  consultation ConsultationDossier? @relation(fields: [consultationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prescripteur Profil?              @relation(fields: [medecinPrescripteurId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([dossierSoinsId])
  @@index([ticketSoinsId])
  @@index([statut])
  @@map("actes_dossier")
}

/// factures_dossier — 4e et dernier des 4 codes anti-fraude (v8 §5). Une facture
/// par ticket de soins clôturé. Le règlement est IMPOSSIBLE tant que l'adhérent
/// n'a pas validé `code_facturation` (garde applicative + trigger). prisma/sql/015.
model FactureDossier {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId        String    @map("organisation_id") @db.Uuid
  dossierSoinsId        String    @map("dossier_soins_id") @db.Uuid
  ticketSoinsId         String    @unique @map("ticket_soins_id") @db.Uuid
  etablissementId       String    @map("etablissement_id") @db.Uuid
  adherentId            String?   @map("adherent_id") @db.Uuid
  beneficiaireId        String?   @map("beneficiaire_id") @db.Uuid
  montantTotal          Decimal   @default(0) @map("montant_total") @db.Decimal(14, 2)
  montantAssurance      Decimal   @default(0) @map("montant_assurance") @db.Decimal(14, 2)
  montantPatient        Decimal   @default(0) @map("montant_patient") @db.Decimal(14, 2)
  statut                String    @default("EMISE") // EMISE | EN_VALIDATION | VALIDEE | REGLEE | CONTESTEE
  codeFacturation       String?   @unique @map("code_facturation")
  codeValideParPatient  Boolean   @default(false) @map("code_valide_par_patient")
  dateValidationPatient DateTime? @map("date_validation_patient") @db.Timestamptz(6)
  dateReglement         DateTime? @map("date_reglement") @db.Timestamptz(6)
  reglePar              String?   @map("regle_par") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dossier        DossierSoins       @relation(fields: [dossierSoinsId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ticket         TicketSoins        @relation(fields: [ticketSoinsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  etablissement  EtablissementSante @relation(fields: [etablissementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  regleParProfil Profil?            @relation(fields: [reglePar], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adherent       Adherent?          @relation(fields: [adherentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  beneficiaire   Beneficiaire?      @relation(fields: [beneficiaireId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organisationId])
  @@index([adherentId])
  @@index([etablissementId])
  @@index([statut])
  @@map("factures_dossier")
}

/// licences_organisation — administration SaaS (v14 §5). Une licence par tenant.
/// prisma/sql/016.
model LicenceOrganisation {
  organisationId      String    @id @map("organisation_id") @db.Uuid
  plan                String    @default("STARTER") // STARTER | BUSINESS | ENTERPRISE
  limiteAdherents     Int?      @map("limite_adherents")
  limiteAppelsApiMois Int?      @map("limite_appels_api_mois")
  dateDebut           DateTime  @default(dbgenerated("CURRENT_DATE")) @map("date_debut") @db.Date
  dateFin             DateTime? @map("date_fin") @db.Date
  statut              String    @default("ACTIVE") // ACTIVE | SUSPENDUE | EXPIREE
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([statut])
  @@map("licences_organisation")
}

/// codes_validation_superadmin — confirmation à deux temps des actions
/// sensibles du superadmin (v14 §5, PROMPT 22). Le code est envoyé par e-mail à
/// SUPERADMIN_EMAIL ; validité 15 min, usage unique. prisma/sql/016.
model CodeValidationSuperadmin {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action         String // CREATION_ORGANISATION | SUSPENSION_ORGANISATION | PROLONGATION_ORGANISATION
  payload        Json
  code           String   @unique
  dateEmission   DateTime @default(now()) @map("date_emission") @db.Timestamptz(6)
  dateExpiration DateTime @default(dbgenerated("(now() + '00:15:00'::interval)")) @map("date_expiration") @db.Timestamptz(6)
  statut         String   @default("EMIS") // EMIS | CONFIRME | EXPIRE | ANNULE
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([statut])
  @@map("codes_validation_superadmin")
}

/// parametres_plateforme — configuration globale de la plateforme (v1 §10.4,
/// PROMPT 23). Devises, pays/villes, taux de taxe, langues. Lecture ET écriture
/// EXCLUSIVEMENT SUPERADMIN_PRINCIPAL. prisma/sql/017.
model ParametrePlateforme {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cle         String   @unique
  valeur      Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("parametres_plateforme")
}

/// referentiel_national_actes — catalogue national partagé des actes (v1 §10.4,
/// PROMPT 23). Mêmes colonnes que `referentiel_actes` SANS organisation_id.
/// Maintenu EXCLUSIVEMENT par SUPERADMIN_PRINCIPAL ; ASSUREUR_INFORMATIQUE
/// l'importe vers le référentiel de SON organisation au statut PROPOSE. prisma/sql/017.
model ReferentielNationalActe {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String    @unique
  libelle             String
  categorie           String?
  versionNomenclature String?   @map("version_nomenclature")
  statut              String    @default("HOMOLOGUE") // PROPOSE | HOMOLOGUE | SUSPENDU | RETIRE
  homologuePar        String?   @map("homologue_par") @db.Uuid
  dateHomologation    DateTime? @map("date_homologation") @db.Timestamptz(6)
  dateRetrait         DateTime? @map("date_retrait") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([statut])
  @@map("referentiel_national_actes")
}

/// referentiel_national_medicaments — catalogue national partagé des médicaments
/// (v1 §10.4, PROMPT 23). Mêmes colonnes que `medicaments` SANS organisation_id.
model ReferentielNationalMedicament {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  denominationCommune   String    @map("denomination_commune")
  nomCommercial         String?   @map("nom_commercial")
  codeEan               String?   @map("code_ean")
  forme                 String?
  dosage                String?
  conditionnement       String?
  classeTherapeutique   String?   @map("classe_therapeutique")
  remboursable          Boolean   @default(false)
  tauxRemboursementStd  Decimal?  @map("taux_remboursement_std") @db.Decimal(5, 2)
  prixReferenceXof      Decimal?  @map("prix_reference_xof") @db.Decimal(14, 2)
  prixMaxRemboursable   Decimal?  @map("prix_max_remboursable") @db.Decimal(14, 2)
  medicamentEssentiel   Boolean   @default(false) @map("medicament_essentiel")
  generiqueDisponible   Boolean?  @map("generique_disponible")
  ordonnanceObligatoire Boolean   @default(true) @map("ordonnance_obligatoire")
  medicamentControle    Boolean   @default(false) @map("medicament_controle")
  usage                 String?
  statutHomologation    String    @default("HOMOLOGUE") @map("statut_homologation")
  homologuePar          String?   @map("homologue_par") @db.Uuid
  dateHomologation      DateTime? @map("date_homologation") @db.Timestamptz(6)
  dateRetrait           DateTime? @map("date_retrait") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([statutHomologation])
  @@map("referentiel_national_medicaments")
}

/// reclamations — une réclamation par acte de dossier (unique sur acte_dossier_id).
/// Machine à états SOUMISE → EN_ADJUDICATION → AUTO_ADJUDIQUE / REVUE_MANUELLE →
/// REJETE / PAYEE (v1 §16, v8). Écriture : NestJS (postgres) + svc_adjudication
/// (UPDATE statut uniquement). prisma/sql/018.
model Reclamation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  dossierSoinsId  String    @map("dossier_soins_id") @db.Uuid
  acteDossierId   String    @map("acte_dossier_id") @db.Uuid
  adherentId      String?   @map("adherent_id") @db.Uuid
  beneficiaireId  String?   @map("beneficiaire_id") @db.Uuid
  policeId        String    @map("police_id") @db.Uuid
  garantieId      String    @map("garantie_id") @db.Uuid
  montant         Decimal   @db.Decimal(14, 2)
  typeReclamation String    @map("type_reclamation") // SOIN | PHARMACIE | HOSPITALISATION | OPTIQUE | DENTAIRE | ANALYSES | IMAGERIE | AUTRE
  statut          String    @default("SOUMISE") // SOUMISE | EN_ADJUDICATION | AUTO_ADJUDIQUE | REVUE_MANUELLE | REJETE | PAYEE
  codesRejet      String[]  @map("codes_rejet")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  remboursement Remboursement?
  adherent      Adherent?      @relation(fields: [adherentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  beneficiaire  Beneficiaire?  @relation(fields: [beneficiaireId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organisationId])
  @@index([statut])
  @@index([dossierSoinsId])
  @@map("reclamations")
}

/// remboursements — résultat d'adjudication, une ligne par réclamation.
/// INSERT-only pour svc_adjudication ; jamais mis à jour. prisma/sql/018.
model Remboursement {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reclamationId       String   @unique @map("reclamation_id") @db.Uuid
  montantRembourse    Decimal  @map("montant_rembourse") @db.Decimal(14, 2)
  plafondRestantApres Decimal? @map("plafond_restant_apres") @db.Decimal(14, 2)
  decision            String
  dureeTraitementMs   Int?     @map("duree_traitement_ms")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reclamation Reclamation @relation(fields: [reclamationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("remboursements")
}
