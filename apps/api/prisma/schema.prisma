// Prisma schema — apps/api
// ---------------------------------------------------------------------------
// Synchronisé avec la base Supabase existante via `npx prisma db pull`
// (dernière synchro : 2026-09-09, après PROMPT 10). Les colonnes ci-dessous
// reflètent la base RÉELLE (schéma `public`). Modèles renommés en PascalCase +
// `@@map` vers les tables snake_case. `@updatedAt` géré côté app (aucun trigger).
//
// Schéma `auth` (Supabase GoTrue) : NON modélisé. `profils.id` référence
// `auth.users(id)` en base ; l'email/identité provient du JWT vérifié.
// Ré-introspecter : ajouter `schemas = ["auth", "public"]`, `db pull --force`,
// puis retirer les modèles/enums `auth` et l'entrée `schemas`.
//
// DDL manuel appliqué (pas de `prisma migrate`) : voir prisma/sql/.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// organisations — tenant racine (compagnie d'assurance / mutuelle). v9 §0.1.
model Organisation {
  id               String    @id @db.Uuid
  nom              String
  raisonSociale    String?   @map("raison_sociale")
  type             String // ASSUREUR | MUTUELLE
  pays             String
  devise           String    @default("XOF")
  emailContact     String?   @map("email_contact")
  telephoneContact String?   @map("telephone_contact")
  statut           String    @default("ACTIVE") // ACTIVE | SUSPENDUE | ARCHIVEE
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  profils           Profil[]
  auditLogs         AuditLog[]
  souscripteurs     Souscripteur[]
  adherents         Adherent[]
  produits          Produit[]
  polices           Police[]
  grillesTarifaires GrilleTarifaire[]
  invitations       Invitation[]
  etablissements    EtablissementSante[]
  pharmacies        Pharmacie[]
  referentielActes  ReferentielActe[]
  tarifsConventionnes TarifConventionne[]
  medicaments       Medicament[]
  dossiersSoins     DossierSoins[]
  codesConsultation CodeConsultation[]
  ordonnances       Ordonnance[]
  codesOrdonnance   CodeOrdonnance[]
  ticketsSoins      TicketSoins[]
  facturesDossier   FactureDossier[]
  licence           LicenceOrganisation?

  @@map("organisations")
}

/// audit_log — journal d'audit unique (alimenté par log_audit(), v9 §1.6). Append-only.
model AuditLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId   String?  @map("organisation_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  action           String
  tableCible       String   @map("table_cible")
  enregistrementId String?  @map("enregistrement_id") @db.Uuid
  details          Json?
  createdAt        DateTime @default(now()) @map("created_at")

  organisation Organisation? @relation(fields: [organisationId], references: [id])

  @@map("audit_log")
}

/// entites_metier — entité métier d'affichage. v9 §2.
model EntiteMetier {
  code    String @id
  libelle String

  sousRoles SousRole[]

  @@map("entites_metier")
}

/// sous_roles — dictionnaire des 25 sous-rôles avec héritage (role_parent_code). v9 addendum A.
model SousRole {
  code           String  @id
  entiteCode     String  @map("entite_code")
  libelle        String
  roleParentCode String? @map("role_parent_code")
  niveauAcces    String  @map("niveau_acces") // LECTURE_SEULE | MODIFICATION | ADMIN
  peutValider    Boolean @default(false) @map("peut_valider")
  dashboardRoute String  @map("dashboard_route")

  entite       EntiteMetier @relation(fields: [entiteCode], references: [code])
  roleParent   SousRole?    @relation("HierarchieSousRole", fields: [roleParentCode], references: [code])
  rolesEnfants SousRole[]   @relation("HierarchieSousRole")
  profils      Profil[]

  reglesCommeCreateur   RegleProvisioning[] @relation("RegleCreateur")
  reglesCommeCree       RegleProvisioning[] @relation("RegleCree")
  reglesCommeValidateur RegleProvisioning[] @relation("RegleValidateur")

  @@map("sous_roles")
}

/// profils — profil applicatif. `id` = auth.users.id. RLS INSERT : prisma/sql/003.
model Profil {
  id                 String    @id @db.Uuid
  organisationId     String?   @map("organisation_id") @db.Uuid
  role               String?
  societeId          String?   @map("societe_id") @db.Uuid
  etablissementId    String?   @map("etablissement_id") @db.Uuid
  pharmacieId        String?   @map("pharmacie_id") @db.Uuid
  adherentId         String?   @map("adherent_id") @db.Uuid
  mfaActive          Boolean?  @default(false) @map("mfa_active")
  methodeConnexion   String?   @map("methode_connexion") // EMAIL_MDP | SSO_GOOGLE | SSO_MICROSOFT | OTP_SMS
  numeroOrdreMedecin String?   @map("numero_ordre_medecin")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation          Organisation?          @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sousRole              SousRole?              @relation(fields: [role], references: [code], onDelete: NoAction, onUpdate: NoAction)
  adherent              Adherent?              @relation(fields: [adherentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membresComite         MembreComiteGestion[]
  avenantsCrees         Avenant[]
  questionnairesValides QuestionnaireMedical[]
  invitationsEmises     Invitation[]
  actesHomologues       ReferentielActe[]
  medicamentsHomologues Medicament[]
  dossiersClotures      DossierSoins[]
  consultations         ConsultationDossier[]
  ordonnancesPrescrites Ordonnance[]
  actesPrescrits        ActeDossier[]
  facturesReglees       FactureDossier[]
  verificationsReseau   VerificationEtablissement[]
  dispensationsPreparees DispensationPharmacie[]
  substitutionsMedicament LigneDispensation[]

  @@map("profils")
}

/// souscripteurs — table unifiée, 3 segments (v9 §1.2).
model Souscripteur {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId         String    @map("organisation_id") @db.Uuid
  type                   String // ENTREPRISE | COLLECTIVITE | INDIVIDUEL
  nom                    String
  secteurActivite        String?   @map("secteur_activite")
  effectifDeclare        Int?      @map("effectif_declare")
  typeCollectivite       String?   @map("type_collectivite")
  organeGouvernance      String?   @map("organe_gouvernance")
  subventionExterne      Boolean   @default(false) @map("subvention_externe")
  bailleurSubvention     String?   @map("bailleur_subvention")
  numeroPieceIdentite    String?   @map("numero_piece_identite")
  questionnaireMedicalId String?   @map("questionnaire_medical_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation           Organisation               @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membresComite          MembreComiteGestion[]
  polices                Police[]
  grillesTarifaires      GrilleTarifaire[]
  planPaiement           PlanPaiementCollectivite[]
  cotisations            Cotisation[]
  questionnairesMedicaux QuestionnaireMedical[]
  adherents              Adherent[]

  @@index([organisationId])
  @@index([type])
  @@index([deletedAt])
  @@map("souscripteurs")
}

/// adherents — personne physique assurée (titulaire). v9 phase 3, PROMPT 12.
/// `numero_adherent` / `numero_carte` générés en base (séquences). prisma/sql/022.
model Adherent {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  souscripteurId      String    @map("souscripteur_id") @db.Uuid
  policeId            String?   @map("police_id") @db.Uuid
  numeroAdherent      String    @unique @default(dbgenerated("(('ADH-'::text || to_char(now(), 'YYYY'::text)) || '-'::text || lpad((nextval('adherents_numero_seq'::regclass))::text, 6, '0'::text))")) @map("numero_adherent")
  nom                 String
  prenom              String
  dateNaissance       DateTime  @map("date_naissance") @db.Date
  sexe                String // M | F
  statut              String    @default("ACTIF") // ACTIF | SUSPENDU | RADIE
  numeroCarte         String    @unique @default(dbgenerated("('CM-'::text || lpad((nextval('cartes_membre_numero_seq'::regclass))::text, 10, '0'::text))")) @map("numero_carte")
  ibanOuRib           String?   @map("iban_ou_rib")
  banqueNom           String?   @map("banque_nom")
  modePaiementPrefere String?   @map("mode_paiement_prefere") // MOBILE_MONEY | VIREMENT_BANCAIRE
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation      Organisation       @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  souscripteur      Souscripteur       @relation(fields: [souscripteurId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  police            Police?            @relation(fields: [policeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  beneficiaires     Beneficiaire[]
  profils           Profil[]
  cotisations       Cotisation[]
  invitations       Invitation[]
  dossiersSoins     DossierSoins[]
  codesConsultation CodeConsultation[]
  codesOrdonnance   CodeOrdonnance[]
  facturesDossier   FactureDossier[]
  reclamations      Reclamation[]

  @@index([organisationId])
  @@index([souscripteurId])
  @@index([policeId])
  @@index([statut])
  @@index([deletedAt])
  @@map("adherents")
}

/// beneficiaires — ayants droit rattachés à un adhérent titulaire. prisma/sql/022.
model Beneficiaire {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adherentId    String    @map("adherent_id") @db.Uuid
  lienParente   String    @map("lien_parente") // CONJOINT | ENFANT | PERE | MERE | AUTRE
  nom           String
  prenom        String
  dateNaissance DateTime  @map("date_naissance") @db.Date
  sexe          String // M | F
  numeroCarte   String    @unique @default(dbgenerated("('CM-'::text || lpad((nextval('cartes_membre_numero_seq'::regclass))::text, 10, '0'::text))")) @map("numero_carte")
  statut        String    @default("ACTIF") // ACTIF | SUSPENDU | RADIE
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  adherent          Adherent           @relation(fields: [adherentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dossiersSoins     DossierSoins[]
  codesConsultation CodeConsultation[]
  codesOrdonnance   CodeOrdonnance[]
  facturesDossier   FactureDossier[]
  reclamations      Reclamation[]

  @@index([adherentId])
  @@index([statut])
  @@map("beneficiaires")
}

/// membres_comite_gestion — gouvernance des collectivités (v9 §1.3).
model MembreComiteGestion {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  souscripteurId  String    @map("souscripteur_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  fonction        String
  dateDebutMandat DateTime  @default(dbgenerated("CURRENT_DATE")) @map("date_debut_mandat") @db.Date
  dateFinMandat   DateTime? @map("date_fin_mandat") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  souscripteur Souscripteur @relation(fields: [souscripteurId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profil       Profil       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([souscripteurId])
  @@index([userId])
  @@map("membres_comite_gestion")
}

/// regles_provisioning — qui peut créer/proposer quel sous-rôle (v9 §1.4 / §1.5). prisma/sql/003.
model RegleProvisioning {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleCreateur   String    @map("role_createur")
  roleCree       String    @map("role_cree")
  scopeVerifie   String?   @map("scope_verifie")
  mode           String    @default("CREATION_DIRECTE") // CREATION_DIRECTE | PROPOSITION
  roleValidateur String?   @map("role_validateur")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  createur   SousRole  @relation("RegleCreateur", fields: [roleCreateur], references: [code], onDelete: NoAction, onUpdate: NoAction)
  cree       SousRole  @relation("RegleCree", fields: [roleCree], references: [code], onDelete: NoAction, onUpdate: NoAction)
  validateur SousRole? @relation("RegleValidateur", fields: [roleValidateur], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roleCreateur, roleCree], map: "regles_provisioning_unique")
  @@index([roleCreateur])
  @@index([roleCree])
  @@map("regles_provisioning")
}

/// produits — formule d'assurance VERSIONNÉE (v9 phase 2.1 / v3 §2). prisma/sql/004.
model Produit {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  nom             String
  version         Int       @default(1)
  statut          String    @default("BROUILLON") // BROUILLON | PUBLIE | ARCHIVE
  datePublication DateTime? @map("date_publication") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation      Organisation      @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  garanties         Garantie[]
  polices           Police[]
  grillesTarifaires GrilleTarifaire[]

  @@unique([organisationId, nom, version], map: "produits_org_nom_version_unique")
  @@index([organisationId])
  @@index([organisationId, nom], map: "produits_org_nom_idx")
  @@index([statut])
  @@index([deletedAt])
  @@map("produits")
}

/// garanties — lignes de couverture d'un produit. Montants en Decimal.
model Garantie {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  produitId         String    @map("produit_id") @db.Uuid
  categorieActe     String    @map("categorie_acte")
  tauxCouverture    Decimal?  @map("taux_couverture") @db.Decimal(5, 2)
  plafondParActe    Decimal?  @map("plafond_par_acte") @db.Decimal(14, 2)
  plafondAnnuel     Decimal?  @map("plafond_annuel") @db.Decimal(14, 2)
  franchise         Decimal?  @db.Decimal(14, 2)
  ticketModerateur  Decimal?  @map("ticket_moderateur") @db.Decimal(5, 2)
  delaiCarenceJours Int?      @map("delai_carence_jours")
  reseauSoins       String    @default("TOUT_RESEAU") @map("reseau_soins") // CONVENTIONNE_SEUL | TOUT_RESEAU
  exclusions        String[]  @default([])
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  produit       Produit        @relation(fields: [produitId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dossiersSoins DossierSoins[]

  @@index([produitId])
  @@map("garanties")
}

/// polices — contrat. Machine à états stricte (PolicyService). Produit PUBLIE requis. prisma/sql/005.
model Police {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  souscripteurId String    @map("souscripteur_id") @db.Uuid
  produitId      String    @map("produit_id") @db.Uuid
  numeroPolice   String    @unique @default(dbgenerated("((('POL-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('polices_numero_seq'::regclass))::text, 6, '0'::text))")) @map("numero_police")
  dateDebut      DateTime? @map("date_debut") @db.Date
  dateFin        DateTime? @map("date_fin") @db.Date
  statut         String    @default("DEVIS") // DEVIS | EN_SOUSCRIPTION | ACTIVE | SUSPENDUE | RENOUVELEE | RESILIEE | NON_RENOUVELEE
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation      Organisation               @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  souscripteur      Souscripteur               @relation(fields: [souscripteurId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produit           Produit                    @relation(fields: [produitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  avenants          Avenant[]
  cotisations       Cotisation[]
  tarifications     TarificationIndividuelle[]
  dossiersSoins     DossierSoins[]
  codesConsultation CodeConsultation[]
  adherents         Adherent[]

  @@index([organisationId])
  @@index([souscripteurId])
  @@index([produitId])
  @@index([statut])
  @@index([deletedAt])
  @@map("polices")
}

/// avenants — modifications contractuelles d'une police. prisma/sql/005.
model Avenant {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policeId               String    @map("police_id") @db.Uuid
  type                   String // AJOUT_ADHERENT | RADIATION_ADHERENT | CHANGEMENT_FORMULE | AJOUT_BENEFICIAIRE | MODIFICATION_TARIFAIRE | RESILIATION
  dateEffet              DateTime  @map("date_effet") @db.Date
  dateCreation           DateTime  @default(now()) @map("date_creation") @db.Timestamptz(6)
  creePar                String?   @map("cree_par") @db.Uuid
  proratisationAppliquee Boolean   @default(false) @map("proratisation_appliquee")
  impactCotisation       Decimal?  @map("impact_cotisation") @db.Decimal(14, 2)
  statut                 String    @default("BROUILLON") // BROUILLON | APPLIQUE | ANNULE
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  police        Police  @relation(fields: [policeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creeParProfil Profil? @relation(fields: [creePar], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([policeId])
  @@index([statut])
  @@map("avenants")
}

/// grilles_tarifaires — tarif par tranche d'âge (v9 phase 2.6). souscripteur_id null =
/// STANDARD, renseigné = NÉGOCIÉ (prioritaire). prisma/sql/006.
model GrilleTarifaire {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  produitId      String    @map("produit_id") @db.Uuid
  trancheAgeMin  Int       @map("tranche_age_min")
  trancheAgeMax  Int       @map("tranche_age_max")
  souscripteurId String?   @map("souscripteur_id") @db.Uuid
  montantMensuel Decimal   @map("montant_mensuel") @db.Decimal(14, 2)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produit      Produit       @relation(fields: [produitId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  souscripteur Souscripteur? @relation(fields: [souscripteurId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([produitId])
  @@index([souscripteurId])
  @@map("grilles_tarifaires")
}

/// plan_paiement_collectivite — modalités de paiement d'une COLLECTIVITE (v9 §2.2). prisma/sql/006.
model PlanPaiementCollectivite {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  souscripteurId         String    @map("souscripteur_id") @db.Uuid
  periodicite            String // MENSUELLE | TRIMESTRIELLE | SAISONNIERE | ANNUELLE
  partMembrePourcent     Decimal   @default(100) @map("part_membre_pourcent") @db.Decimal(5, 2)
  partSubventionPourcent Decimal   @default(0) @map("part_subvention_pourcent") @db.Decimal(5, 2)
  echeances              Json?
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  souscripteur Souscripteur @relation(fields: [souscripteurId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("plan_paiement_collectivite")
}

/// cotisations — appels de cotisation. adherent_id XOR societe_id (CHECK). prisma/sql/006.
model Cotisation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policeId          String    @map("police_id") @db.Uuid
  adherentId        String?   @map("adherent_id") @db.Uuid
  societeId         String?   @map("societe_id") @db.Uuid
  periode           DateTime  @db.Date
  montantDu         Decimal   @map("montant_du") @db.Decimal(14, 2)
  montantPaye       Decimal   @default(0) @map("montant_paye") @db.Decimal(14, 2)
  dateEcheance      DateTime  @map("date_echeance") @db.Date
  statut            String    @default("A_PAYER") // A_PAYER | PAYEE | EN_RETARD | ANNULEE
  penaliteAppliquee Decimal   @default(0) @map("penalite_appliquee") @db.Decimal(14, 2)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  police   Police        @relation(fields: [policeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  societe  Souscripteur? @relation(fields: [societeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adherent Adherent?     @relation(fields: [adherentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([policeId])
  @@index([statut])
  @@index([dateEcheance])
  @@map("cotisations")
}

/// questionnaires_medicaux — évaluation médicale à la souscription INDIVIDUELLE
/// (v4 §3.1, v10 §3). SÉPARATION STRICTE : décision réservée à
/// ASSUREUR_MEDECIN_SOUSCRIPTEUR ; ASSUREUR_MEDECIN_CONSEIL n'a AUCUN accès.
/// `decision` null tant que non traité. prisma/sql/007.
model QuestionnaireMedical {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  souscripteurId        String    @map("souscripteur_id") @db.Uuid
  reponses              Json      @default("{}")
  antecedentsDeclares   String[]  @default([]) @map("antecedents_declares")
  dateSoumission        DateTime? @map("date_soumission") @db.Timestamptz(6)
  decision              String? // ACCEPTE | ACCEPTE_AVEC_EXCLUSION | ACCEPTE_SURPRIME | REFUSE
  exclusionsSpecifiques String[]  @default([]) @map("exclusions_specifiques")
  surprimePourcent      Decimal   @default(0) @map("surprime_pourcent") @db.Decimal(6, 2)
  validePar             String?   @map("valide_par") @db.Uuid
  dateDecision          DateTime? @map("date_decision") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  souscripteur  Souscripteur               @relation(fields: [souscripteurId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  validateur    Profil?                    @relation(fields: [validePar], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tarifications TarificationIndividuelle[]

  @@index([souscripteurId])
  @@index([decision])
  @@map("questionnaires_medicaux")
}

/// tarification_individuelle — prime individuelle = prime_base + surprime_medicale
/// (colonne `prime_finale` GENERATED ALWAYS AS ... STORED — ne pas écrire). prisma/sql/007.
model TarificationIndividuelle {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policeId               String   @map("police_id") @db.Uuid
  questionnaireMedicalId String   @map("questionnaire_medical_id") @db.Uuid
  ageASubscription       Int      @map("age_a_souscription")
  primeBase              Decimal  @map("prime_base") @db.Decimal(14, 2)
  surprimeMedicale       Decimal  @default(0) @map("surprime_medicale") @db.Decimal(14, 2)
  primeFinale            Decimal? @map("prime_finale") @db.Decimal(14, 2) // GENERATED — lecture seule
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  police        Police               @relation(fields: [policeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  questionnaire QuestionnaireMedical @relation(fields: [questionnaireMedicalId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([policeId])
  @@index([questionnaireMedicalId], map: "tarification_individuelle_questionnaire_id_idx")
  @@map("tarification_individuelle")
}

/// invitations — flux d'invitation sécurisé (v5 §3, PROMPT 6). L'invité définit
/// lui-même son mot de passe ; il n'est jamais généré ni vu côté serveur.
/// mode = PROPOSITION → statut EN_ATTENTE_VALIDATION_INFORMATIQUE jusqu'à
/// validation par `roleValidateur`. prisma/sql/008.
model Invitation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String
  telephone       String?
  rolePropose     String    @map("role_propose")
  organisationId  String?   @map("organisation_id") @db.Uuid
  societeId       String?   @map("societe_id") @db.Uuid
  etablissementId String?   @map("etablissement_id") @db.Uuid
  pharmacieId     String?   @map("pharmacie_id") @db.Uuid
  adherentId      String?   @map("adherent_id") @db.Uuid
  invitePar       String    @map("invite_par") @db.Uuid
  token           String    @unique
  statut          String    @default("EN_ATTENTE") // EN_ATTENTE_VALIDATION_INFORMATIQUE | EN_ATTENTE | ACCEPTEE | REJETEE | EXPIREE | REVOQUEE
  mode            String    @default("CREATION_DIRECTE") // CREATION_DIRECTE | PROPOSITION
  roleValidateur  String?   @map("role_validateur")
  authUserId      String?   @map("auth_user_id") @db.Uuid
  motifRejet      String?   @map("motif_rejet")
  /// NULL = aucun essai d'envoi réel encore tenté (proposition en attente,
  /// ou ligne historique antérieure à cette colonne).
  emailEnvoye     Boolean?  @map("email_envoye")
  expireLe        DateTime  @default(dbgenerated("(now() + '72:00:00'::interval)")) @map("expire_le") @db.Timestamptz(6)
  accepteLe       DateTime? @map("accepte_le") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  emetteur     Profil        @relation(fields: [invitePar], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adherent     Adherent?     @relation(fields: [adherentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([invitePar])
  @@index([statut])
  @@map("invitations")
}

/// etablissements_sante — réseau de soins (entité d'affichage CENTRE_MEDICAL,
/// v9 §1.1). Écriture réservée à ASSUREUR_INFORMATIQUE. prisma/sql/009.
model EtablissementSante {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  nom               String
  code              String    @unique
  typeEtablissement String    @map("type_etablissement") // HOPITAL_PUBLIC | CLINIQUE_PRIVEE | CABINET_MEDICAL | CENTRE_SANTE | LABORATOIRE | CENTRE_IMAGERIE | OPTICIEN | DENTISTE | MATERNITE
  pays              String    @default("Côte d'Ivoire")
  ville             String?
  commune           String?
  quartier          String?
  adresseComplete   String?   @map("adresse_complete")
  latitude          Float?
  longitude         Float?
  telephone         String?
  telephoneUrgence  String?   @map("telephone_urgence")
  email             String?
  statut            String    @default("EN_ATTENTE_VALIDATION") // ACTIF | SUSPENDU | EN_ATTENTE_VALIDATION | RESILIE
  dateConvention    DateTime? @map("date_convention") @db.Date
  dateFinConvention DateTime? @map("date_fin_convention") @db.Date
  gardeWeekend      Boolean   @default(false) @map("garde_weekend")
  horairesGarde     Json?     @map("horaires_garde")
  horairesSemaine   Json?     @map("horaires_semaine")
  tiersPayant       Boolean   @default(true) @map("tiers_payant")
  verificationStatut       String?   @map("verification_statut") // ACTIF | FERME | DEMENAGE | A_REVERIFIER
  dateDerniereVerification DateTime? @map("date_derniere_verification") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation       Organisation       @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dossiers           DossierSoins[]     @relation("DossierEtablissement")
  dossiersTransferes DossierSoins[]     @relation("DossierTransfereVers")
  codesConsultation  CodeConsultation[]
  factures           FactureDossier[]
  verifications      VerificationEtablissement[]
  tarifsConventionnes TarifConventionne[]

  @@index([organisationId])
  @@index([statut])
  @@index([verificationStatut])
  @@map("etablissements_sante")
}

/// pharmacies — réseau de soins (entité PHARMACIE). Écriture réservée à
