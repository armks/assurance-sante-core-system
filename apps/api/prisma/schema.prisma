/// verifications_etablissement — historique des vérifications terrain d'un
/// établissement OU d'une pharmacie (v8 §9, PROMPT 15). prisma/sql/024.
model VerificationEtablissement {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  etablissementId  String?  @map("etablissement_id") @db.Uuid
  pharmacieId      String?  @map("pharmacie_id") @db.Uuid
  dateVerification DateTime @default(now()) @map("date_verification") @db.Timestamptz(6)
  methode          String // APPEL_TELEPHONIQUE | VISITE_TERRAIN | AUTO_DECLARATIF
  statutConfirme   String   @map("statut_confirme") // ACTIF | FERME | DEMENAGE | A_REVERIFIER
  verifiePar       String?  @map("verifie_par") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  etablissement EtablissementSante? @relation(fields: [etablissementId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pharmacie     Pharmacie?          @relation(fields: [pharmacieId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  verificateur  Profil?             @relation(fields: [verifiePar], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([etablissementId, dateVerification])
  @@index([pharmacieId, dateVerification])
  @@map("verifications_etablissement")
}

/// referentiel_actes — nomenclature des actes (v3 §9). Gouvernance d'homologation
/// PROPOSE → HOMOLOGUE → SUSPENDU/RETIRE (v8 §10). Passage à HOMOLOGUE réservé à
/// ASSUREUR_MEDECIN_CONSEIL. prisma/sql/010.
model ReferentielActe {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  code                String // unique parmi les non supprimés : index partiel (prisma/sql/074)
  libelle             String
  categorie           String?
  versionNomenclature String?   @map("version_nomenclature")
  statut              String    @default("PROPOSE") // PROPOSE | HOMOLOGUE | SUSPENDU | RETIRE
  homologuePar        String?   @map("homologue_par") @db.Uuid
  dateHomologation    DateTime? @map("date_homologation") @db.Timestamptz(6)
  dateRetrait         DateTime? @map("date_retrait") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// Cotation (prisma/sql/080) : lettre-clé + coefficient (aucun prix en FCFA ici), mode isolé / groupé,
  /// catégorie de GARANTIE (distincte du chapitre `categorie`), code de groupe.
  lettreCleCode       String?   @map("lettre_cle_code")
  coefficient         Decimal?  @db.Decimal(8, 2)
  modeCotation        String    @default("ISOLE") @map("mode_cotation") // ISOLE | GROUPE
  categorieGarantie   String?   @map("categorie_garantie")
  groupeCode          String?   @map("groupe_code")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  homologateur Profil?      @relation(fields: [homologuePar], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conventionActes     ConventionActe[]
  actesDossier        ActeDossier[]
  tarifsConventionnes TarifConventionne[]

  @@index([organisationId])
  lettreCle           LettreCle?     @relation(fields: [lettreCleCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  categorieGarantieRef CategorieActe? @relation("ReferentielActeCategorieGarantie", fields: [categorieGarantie], references: [code], onDelete: Restrict, onUpdate: Cascade)
  @@index([statut])
  @@map("referentiel_actes")
}

/// tarifs_conventionnes — tarif négocié établissement/pharmacie × acte (v3 §5,
/// plan directeur phase 4.2 « Grilles tarifaires conventionnées »). DIFFÉRENT de
/// `grilles_tarifaires` (cotisation par tranche d'âge/souscripteur, PROMPT 11).
/// Utilisé par le microservice d'adjudication : min(montant_facture,
/// tarif_convention) avant application du taux de couverture. prisma/sql/033.
model TarifConventionne {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String    @map("organisation_id") @db.Uuid
  etablissementId    String?   @map("etablissement_id") @db.Uuid
  pharmacieId        String?   @map("pharmacie_id") @db.Uuid
  referentielActeId  String    @map("referentiel_acte_id") @db.Uuid
  tarifConvention    Decimal   @map("tarif_convention") @db.Decimal(14, 2)
  dateDebut          DateTime  @map("date_debut") @db.Date
  dateFin            DateTime? @map("date_fin") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation    Organisation       @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  etablissement   EtablissementSante? @relation(fields: [etablissementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pharmacie       Pharmacie?         @relation(fields: [pharmacieId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referentielActe ReferentielActe    @relation(fields: [referentielActeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actesCalcules   ActeDossier[]       @relation("ActeTarifConventionne")
  lignesDispensation LigneDispensation[] @relation("LigneTarifPharmacie")

  @@index([organisationId])
  @@index([etablissementId])
  @@index([pharmacieId])
  @@index([referentielActeId])
  @@map("tarifs_conventionnes")
}

/// medicaments — référentiel des médicaments (v3 §9). Passage à HOMOLOGUE réservé
/// à ASSUREUR_PHARMACIEN_CONSEIL (v8 §10.2). prisma/sql/010.
model Medicament {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId        String    @map("organisation_id") @db.Uuid
  denominationCommune   String    @map("denomination_commune")
  nomCommercial         String?   @map("nom_commercial")
  codeEan               String?   @map("code_ean")
  forme                 String?
  dosage                String?
  conditionnement       String?
  classeTherapeutique   String?   @map("classe_therapeutique")
  remboursable          Boolean   @default(false)
  tauxRemboursementStd  Decimal?  @map("taux_remboursement_std") @db.Decimal(5, 2)
  prixReferenceXof      Decimal?  @map("prix_reference_xof") @db.Decimal(14, 2)
  prixMaxRemboursable   Decimal?  @map("prix_max_remboursable") @db.Decimal(14, 2)
  medicamentEssentiel   Boolean   @default(false) @map("medicament_essentiel")
  generiqueDisponible   Boolean?  @map("generique_disponible")
  ordonnanceObligatoire Boolean   @default(true) @map("ordonnance_obligatoire")
  medicamentControle    Boolean   @default(false) @map("medicament_controle")
  usage                 String? // AMBULATOIRE | HOSPITALIER | LES_DEUX
  statutHomologation    String    @default("PROPOSE") @map("statut_homologation") // PROPOSE | HOMOLOGUE | SUSPENDU | RETIRE
  homologuePar          String?   @map("homologue_par") @db.Uuid
  dateHomologation      DateTime? @map("date_homologation") @db.Timestamptz(6)
  dateRetrait           DateTime? @map("date_retrait") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  homologateur Profil?      @relation(fields: [homologuePar], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organisationId])
  @@index([statutHomologation])
  @@map("medicaments")
}

/// dossiers_soins — Dossier de Soins + Numéro de Traitement (v1 §15). Ouverture
/// pilotée par le MoteurOuvertureDossier (CareEpisodeService). prisma/sql/011.
model DossierSoins {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String    @map("organisation_id") @db.Uuid
  numeroTraitement   String    @unique @default(dbgenerated("(((('TRT-'::text || to_char(now(), 'YYYY-MM'::text)) || '-'::text) || lpad((nextval('dossiers_soins_numero_seq'::regclass))::text, 6, '0'::text)))")) @map("numero_traitement")
  adherentId         String?   @map("adherent_id") @db.Uuid
  beneficiaireId     String?   @map("beneficiaire_id") @db.Uuid
  etablissementId    String    @map("etablissement_id") @db.Uuid
  policeId           String    @map("police_id") @db.Uuid
  planCouvertureId   String?   @map("plan_couverture_id") @db.Uuid
  statut             String    @default("OUVERT") // OUVERT | SUSPENDU | TRANSFERE | CLOTURE | FORCE_CLOS
  /// Choisi UNE FOIS, à l'intérieur du dossier, après son ouverture (jamais
  /// avant — l'ouverture reste conditionnée au seul code de consultation).
  /// NULL = pas encore choisi. prisma/sql/036.
  typeVisite         String?   @map("type_visite") // CONSULTATION_GENERALISTE | CONSULTATION_SPECIALISTE | HOSPITALISATION_MEDICALE | ANALYSES_EXAMENS_MEDICAUX | ACTES_DENTAIRES | CONSULTATION_DENTAIRE | PRESCRIPTION_MEDICALE
  dateOuverture      DateTime  @default(now()) @map("date_ouverture") @db.Timestamptz(6)
  dateCloture        DateTime? @map("date_cloture") @db.Timestamptz(6)
  motifConsultation  String?   @map("motif_consultation")
  diagnosticEntree   String?   @map("diagnostic_entree")
  codeCim10          String?   @map("code_cim10")
  carteValide        Boolean?  @map("carte_valide")
  adherentEligible   Boolean?  @map("adherent_eligible")
  aucunDossierOuvert Boolean?  @map("aucun_dossier_ouvert")
  horsDelaiCarence   Boolean?  @map("hors_delai_carence")
  blocageRaison      String?   @map("blocage_raison")
  cloturePar         String?   @map("cloture_par") @db.Uuid
  clotureMotif       String?   @map("cloture_motif")
  clotureType        String?   @map("cloture_type") // NORMALE | FORCEE
  transfereVers      String?   @map("transfere_vers") @db.Uuid
  dossierOrigine     String?   @map("dossier_origine") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation      Organisation          @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  etablissement     EtablissementSante    @relation("DossierEtablissement", fields: [etablissementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  police            Police                @relation(fields: [policeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  planCouverture    Garantie?             @relation(fields: [planCouvertureId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clotureParProfil  Profil?               @relation(fields: [cloturePar], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adherent          Adherent?             @relation(fields: [adherentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  beneficiaire      Beneficiaire?         @relation(fields: [beneficiaireId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transfereVersEtab EtablissementSante?   @relation("DossierTransfereVers", fields: [transfereVers], references: [id], onDelete: NoAction, onUpdate: NoAction)
  origine           DossierSoins?         @relation("DossierDerive", fields: [dossierOrigine], references: [id], onDelete: NoAction, onUpdate: NoAction)
  derives           DossierSoins[]        @relation("DossierDerive")
  consultations     ConsultationDossier[]
  codesConsultation CodeConsultation[]
  ordonnances       Ordonnance[]
  ticket            TicketSoins?
  actes             ActeDossier[]
  factures          FactureDossier[]
  notes             NoteDossier[]

  @@index([organisationId])
  @@index([etablissementId])
  @@index([statut])
  @@map("dossiers_soins")
}

/// consultations_dossier — passages médicaux d'un dossier. `medecinId` DOIT être
/// un CENTRE_MEDICAL_MEDECIN du même établissement (v10 §1) — vérifié par trigger
/// + policy RLS + CareEpisodeService. prisma/sql/011.
model ConsultationDossier {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numeroConsultation String    @unique @default(dbgenerated("(((('CST-'::text || to_char(now(), 'YYYY-MM'::text)) || '-'::text) || lpad((nextval('consultations_dossier_numero_seq'::regclass))::text, 6, '0'::text)))")) @map("numero_consultation")
  dossierSoinsId     String    @map("dossier_soins_id") @db.Uuid
  medecinId          String    @map("medecin_id") @db.Uuid
  dateConsultation   DateTime  @default(now()) @map("date_consultation") @db.Timestamptz(6)
  motif              String?
  observations       String?
  diagnostic         String?
  codeCim10          String?   @map("code_cim10")
  statut             String    @default("EN_COURS") // EN_COURS | TERMINEE | ANNULEE
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  dossier     DossierSoins  @relation(fields: [dossierSoinsId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  medecin     Profil        @relation(fields: [medecinId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordonnances Ordonnance[]
  actes       ActeDossier[]

  @@index([dossierSoinsId])
  @@index([medecinId])
  @@map("consultations_dossier")
}

/// codes_consultation — 1er des 4 codes anti-fraude (v8 §2). Généré côté serveur,
/// envoyé à l'adhérent, saisi par l'établissement. Sa validation est la SEULE
/// voie d'ouverture d'un dossier de soins. prisma/sql/012.
model CodeConsultation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String   @map("organisation_id") @db.Uuid
  adherentId      String?  @map("adherent_id") @db.Uuid
  beneficiaireId  String?  @map("beneficiaire_id") @db.Uuid
  etablissementId String   @map("etablissement_id") @db.Uuid
  policeId        String   @map("police_id") @db.Uuid
  code            String   @unique
  dateEmission    DateTime @default(now()) @map("date_emission") @db.Timestamptz(6)
  dateExpiration  DateTime @default(dbgenerated("(now() + '48:00:00'::interval)")) @map("date_expiration") @db.Timestamptz(6)
  statut          String   @default("EMIS") // EMIS | CONFIRME_PATIENT | UTILISE_ETABLISSEMENT | EXPIRE | ANNULE
  canalEnvoi      String[] @default(["APP", "SMS"]) @map("canal_envoi")
  dossierSoinsId  String?  @map("dossier_soins_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation  Organisation       @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  etablissement EtablissementSante @relation(fields: [etablissementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  police        Police             @relation(fields: [policeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dossier       DossierSoins?      @relation(fields: [dossierSoinsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adherent      Adherent?          @relation(fields: [adherentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  beneficiaire  Beneficiaire?      @relation(fields: [beneficiaireId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organisationId])
  @@index([adherentId])
  @@index([etablissementId])
  @@index([statut])
  @@map("codes_consultation")
}

/// ordonnances — table minimale (v8 §3, PROMPT 19). `lignes` = liste JSON de
/// médicaments/posologie ; le référentiel `medicaments` viendra l'affiner.
/// prisma/sql/013.
model Ordonnance {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  dossierSoinsId   String    @map("dossier_soins_id") @db.Uuid
  consultationId   String    @map("consultation_id") @db.Uuid
  medecinId        String    @map("medecin_id") @db.Uuid
  lignes           Json      @default("[]")
  statut           String    @default("ACTIVE") // ACTIVE | PARTIELLEMENT_DELIVREE | COMPLETEMENT_DELIVREE | EXPIREE | ANNULEE
  datePrescription DateTime  @default(now()) @map("date_prescription") @db.Timestamptz(6)
  /// 7 → 14 jours (prisma/sql/040) — délai jugé trop court en pratique.
  dateValidite     DateTime  @default(dbgenerated("(now() + '14 days'::interval)")) @map("date_validite") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dossier      DossierSoins        @relation(fields: [dossierSoinsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  consultation ConsultationDossier @relation(fields: [consultationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medecin      Profil              @relation(fields: [medecinId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  codes        CodeOrdonnance[]
  lignesOrdonnance LigneOrdonnance[]
  dispensationsPharmacie DispensationPharmacie[]

  @@index([organisationId])
  @@index([dossierSoinsId])
  @@index([consultationId])
  @@index([statut])
  @@map("ordonnances")
}

/// lignes_ordonnance — révision majeure (clarification métier) : remplace
/// `ordonnances.lignes` (jsonb) par une vraie table, pour un verrou PAR LIGNE
/// (pas par ordonnance entière comme au PROMPT 19). `statut` ne passe à SERVIE
/// qu'au règlement confirmé d'une dispensation (jamais à la préparation) —
/// voir `PharmacyService.confirmerPaiementDispensation`. prisma/sql/026.
model LigneOrdonnance {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ordonnanceId           String    @map("ordonnance_id") @db.Uuid
  denominationMedicament String    @map("denomination_medicament")
  dosage                 String?
  posologie              String
  duree                  String?
  quantitePrescrite      Int       @default(1) @map("quantite_prescrite")
  statut                 String    @default("DISPONIBLE") @map("statut") // DISPONIBLE | SERVIE
  pharmacieServanteId    String?   @map("pharmacie_servante_id") @db.Uuid
  quantiteServie         Int?      @map("quantite_servie")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ordonnance       Ordonnance          @relation(fields: [ordonnanceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pharmacieServante Pharmacie?         @relation(fields: [pharmacieServanteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lignesDispensation LigneDispensation[]
  contestations    ContestationPrescription[]

  @@index([ordonnanceId])
  @@index([statut])
  @@index([pharmacieServanteId])
  @@map("lignes_ordonnance")
}

/// contestations_prescription — revue du pharmacien conseil sur une ligne
/// d'ordonnance prescrite. Tant que OUVERT/JUSTIFICATION_RECUE (temporaire)
/// ou REJETEE (définitif), la ligne est exclue de tout calcul de montant
/// facturable (`PharmacyService` renvoie `enLitige: true` à la place d'un
/// montant, partout où celui-ci apparaît) — seul VALIDEE la débloque.
/// `dateLimite` par défaut à la fin du mois en cours. prisma/sql/043.
model ContestationPrescription {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId       String    @map("organisation_id") @db.Uuid
  ligneOrdonnanceId    String    @map("ligne_ordonnance_id") @db.Uuid
  ouvertParId          String    @map("ouvert_par_id") @db.Uuid
  motif                String
  dateOuverture        DateTime  @default(now()) @map("date_ouverture") @db.Timestamptz(6)
  dateLimite           DateTime  @default(dbgenerated("(date_trunc('month'::text, now()) + '1 mon'::interval)")) @map("date_limite") @db.Timestamptz(6)
  statut               String    @default("OUVERT") // OUVERT | JUSTIFICATION_RECUE | VALIDEE | REJETEE
  reponseEtablissement String?   @map("reponse_etablissement")
  piecesJustificatives String[]  @default([]) @map("pieces_justificatives")
  traiteParId          String?   @map("traite_par_id") @db.Uuid
  dateCloture          DateTime? @map("date_cloture") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation    Organisation    @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ligneOrdonnance LigneOrdonnance @relation(fields: [ligneOrdonnanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ouvertPar       Profil          @relation("ContestationOuvertePar", fields: [ouvertParId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  traitePar       Profil?         @relation("ContestationTraiteePar", fields: [traiteParId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organisationId])
  @@index([ligneOrdonnanceId])
  @@index([statut])
  @@map("contestations_prescription")
}

/// contestations_acte — même principe que ContestationPrescription, mais sur
/// actes_dossier (actes/hospitalisations/analyses-examens) et réservée à
/// ASSUREUR_MEDECIN_CONSEIL plutôt qu'ASSUREUR_PHARMACIEN_CONSEIL. prisma/sql/046.
model ContestationActe {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId       String    @map("organisation_id") @db.Uuid
  acteDossierId        String    @map("acte_dossier_id") @db.Uuid
  ouvertParId          String    @map("ouvert_par_id") @db.Uuid
  motif                String
  dateOuverture        DateTime  @default(now()) @map("date_ouverture") @db.Timestamptz(6)
  dateLimite           DateTime  @default(dbgenerated("(date_trunc('month'::text, now()) + '1 mon'::interval)")) @map("date_limite") @db.Timestamptz(6)
  statut               String    @default("OUVERT") // OUVERT | JUSTIFICATION_RECUE | VALIDEE | REJETEE
  reponseEtablissement String?   @map("reponse_etablissement")
  piecesJustificatives String[]  @default([]) @map("pieces_justificatives")
  traiteParId          String?   @map("traite_par_id") @db.Uuid
  dateCloture          DateTime? @map("date_cloture") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  acteDossier  ActeDossier  @relation(fields: [acteDossierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ouvertPar    Profil       @relation("ContestationActeOuvertePar", fields: [ouvertParId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  traitePar    Profil?      @relation("ContestationActeTraiteePar", fields: [traiteParId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organisationId])
  @@index([acteDossierId])
  @@index([statut])
  @@map("contestations_acte")
}

/// stock_medicaments_pharmacie — chaque pharmacie fixe son propre prix par
/// dénomination (texte libre, pas de FK vers le référentiel national). Gap
/// documenté au prompt précédent, comblé ici. prisma/sql/026.
model StockMedicamentPharmacie {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pharmacieId            String   @map("pharmacie_id") @db.Uuid
  denominationMedicament String   @map("denomination_medicament")
  prixPharmacie          Decimal? @map("prix_pharmacie") @db.Decimal(14, 2)
  disponible             Boolean  @default(true)
  dateMaj                DateTime @default(now()) @map("date_maj") @db.Timestamptz(6)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pharmacie Pharmacie @relation(fields: [pharmacieId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([pharmacieId, denominationMedicament])
  @@index([pharmacieId])
  @@map("stock_medicaments_pharmacie")
}

/// dispensations_pharmacie — cycle de vie complet du nouveau flux pharmacie
/// (EN_PREPARATION → EN_ATTENTE_VALIDATION_PATIENT → VALIDEE → PAYEE), même
/// garde anti-fraude bloquante que les 4 codes déjà construits (v8) : paiement
/// impossible sans validation du code par le patient (trigger
/// verifier_dispensation_payable). prisma/sql/026.
model DispensationPharmacie {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ordonnanceId          String    @map("ordonnance_id") @db.Uuid
  pharmacieId           String    @map("pharmacie_id") @db.Uuid
  /// utilisateur ayant préparé la dispensation (n'importe lequel des 3
  /// sous-rôles PHARMACIE_*, nom de colonne conservé tel que spécifié).
  caissiereId           String    @map("caissiere_id") @db.Uuid
  montantTotal          Decimal   @default(0) @map("montant_total") @db.Decimal(14, 2)
  statut                String    @default("EN_PREPARATION") // EN_PREPARATION | EN_ATTENTE_VALIDATION_PATIENT | VALIDEE | PAYEE | ANNULEE
  codeConfirmation      String?   @unique @map("code_confirmation")
  datePreparation       DateTime  @default(now()) @map("date_preparation") @db.Timestamptz(6)
  dateValidationPatient DateTime? @map("date_validation_patient") @db.Timestamptz(6)
  datePaiement          DateTime? @map("date_paiement") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  ordonnance Ordonnance          @relation(fields: [ordonnanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pharmacie  Pharmacie           @relation(fields: [pharmacieId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  preparateur Profil             @relation(fields: [caissiereId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lignes     LigneDispensation[]
  reclamations Reclamation[]

  @@index([ordonnanceId])
  @@index([pharmacieId])
  @@index([statut])
  @@map("dispensations_pharmacie")
}

model LigneDispensation {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dispensationId      String    @map("dispensation_id") @db.Uuid
  ligneOrdonnanceId   String    @map("ligne_ordonnance_id") @db.Uuid
  prixUnitaire        Decimal   @map("prix_unitaire") @db.Decimal(14, 2)
  quantite            Int       @default(1)
  montantLigne        Decimal   @map("montant_ligne") @db.Decimal(14, 2)
  /// Part assurance / part patient — calculées à la préparation depuis
  /// `garanties.tauxCouverture` (catégorie PHARMACIE) de la police du
  /// patient, même logique que `PreauthorizationService.simulerMontantActe`.
  /// prisma/sql/040.
  montantAssurance    Decimal   @default(0) @map("montant_assurance") @db.Decimal(14, 2)
  montantPatient      Decimal   @default(0) @map("montant_patient") @db.Decimal(14, 2)
  /// Prix national de référence du médicament à la date de la dispensation, majoration appliquée par la
  /// pharmacie (prix saisi au comptoir / prix de référence - 1) et alerte au-delà du seuil — prisma/sql/078.
  prixReference       Decimal?  @map("prix_reference") @db.Decimal(14, 2)
  majorationPourcent  Decimal?  @map("majoration_pourcent") @db.Decimal(8, 2)
  majorationAnormale  Boolean   @default(false) @map("majoration_anormale")
  /// substitution réservée à PHARMACIE_PHARMACIEN OU ASSUREUR_PHARMACIEN_CONSEIL
  /// (capacité additive depuis prisma/sql/044), avant confirmation du paiement
  /// uniquement (v. PharmacyService.substituerMedicament) — l'audit distingue
  /// SUBSTITUTION_PHARMACIEN de SUBSTITUTION_PHARMACIEN_CONSEIL.
  medicamentSubstitue String?   @map("medicament_substitue")
  motifSubstitution   String?   @map("motif_substitution")
  substitueParId      String?   @map("substitue_par_id") @db.Uuid
  dateSubstitution    DateTime? @map("date_substitution") @db.Timestamptz(6)
  /// Consolidation mensuelle (prisma/sql/044) : renseigné dès qu'une facture
  /// mensuelle a « réclamé » cette ligne (statut PAYEE au moment de la
  /// soumission, jamais en litige). Reste NULL tant que la ligne n'a pas été
  /// incluse — une ligne exclue pour litige redevient éligible le mois suivant.
  factureMensuelleId String? @map("facture_mensuelle_id") @db.Uuid
  /// Décochée manuellement par ASSUREUR_COMPTABLE (`decocherLigneContestee`,
  /// prisma/sql/048) ou exclue automatiquement à la soumission pour litige —
  /// candidate à la réintégration automatique dès que la contestation associée
  /// n'est plus en litige (VALIDEE) ; reste définitivement non réclamée si
  /// REJETEE (`STATUTS_CONTESTATION_EN_LITIGE` inclut déjà REJETEE).
  reporteeMoisSuivant Boolean @default(false) @map("reportee_mois_suivant")
  /// tarif conventionné de la pharmacie appliqué (vide tant que le comptoir calcule au prix du stock) — prisma/sql/074
  tarifPharmacieId    String?   @map("tarif_pharmacie_id") @db.Uuid

  dispensation    DispensationPharmacie      @relation(fields: [dispensationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ligneOrdonnance LigneOrdonnance            @relation(fields: [ligneOrdonnanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  substituePar    Profil?                    @relation(fields: [substitueParId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  factureMensuelle FactureMensuellePharmacie? @relation(fields: [factureMensuelleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tarifPharmacie   TarifConventionne?         @relation("LigneTarifPharmacie", fields: [tarifPharmacieId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([dispensationId])
  @@index([ligneOrdonnanceId])
  @@index([factureMensuelleId])
  @@map("lignes_dispensation")
}

/// factures_mensuelles_pharmacie — consolidation mensuelle du montant dû par
/// l'assureur à une pharmacie (somme des `montant_assurance` des lignes
/// PAYEE de la période, hors lignes en litige — v. `ContestationPrescription`).
/// Circuit à 3 niveaux : PHARMACIE soumet → ASSUREUR_PHARMACIEN_CONSEIL valide
/// (double vérification anti-litige) → ASSUREUR_COMPTABLE programme puis
/// marque payée. `ASSUREUR_COMPTABLE` n'a AUCUN accès (lecture ni écriture)
/// tant que le statut n'a pas atteint VALIDEE_PHARMACIEN_CONSEIL — verrouillé
/// en RLS, pas seulement côté NestJS. prisma/sql/044.
model FactureMensuellePharmacie {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  pharmacieId       String    @map("pharmacie_id") @db.Uuid
  /// Premier jour du mois concerné (ex. 2026-08-01 pour août 2026).
  periode           DateTime  @db.Date
  montantTotal      Decimal   @default(0) @map("montant_total") @db.Decimal(14, 2)
  statut            String    @default("EN_PREPARATION") // EN_PREPARATION | SOUMISE | VALIDEE_PHARMACIEN_CONSEIL | PROGRAMMEE_PAIEMENT | PAYEE
  dateSoumission    DateTime? @map("date_soumission") @db.Timestamptz(6)
  valideParId       String?   @map("valide_par_id") @db.Uuid
  dateValidation    DateTime? @map("date_validation") @db.Timestamptz(6)
  dateProgrammation DateTime? @map("date_programmation") @db.Timestamptz(6)
  datePaiement      DateTime? @map("date_paiement") @db.Timestamptz(6)
  /// Nombre de lignes décochées pour litige depuis cette facture (prisma/sql/048,
  /// `decocherLigneContestee`) — distingue une facture PAYEE intégralement d'une
  /// facture PAYEE mais partiellement réglée (certaines lignes reportées).
  nbLignesReportees Int       @default(0) @map("nb_lignes_reportees")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Paiement RÉEL (prisma/sql/051, `PaymentService.payerFacture`) — cumul
  /// déjà réglé depuis un compte financier ; `montantTotal - montantPaye` =
  /// solde restant dû (statut PARTIELLEMENT_REGLEE tant que > 0).
  montantPaye Decimal @default(0) @map("montant_paye") @db.Decimal(14, 2)
  /// Paiement programmé à une date future (`payerFacture` avec `dateProgrammee`)
  /// — NE débite RIEN tant que non confirmé (rappel de `payerFacture` sans
  /// date future, ou date atteinte) : statut passe alors à PAIEMENT_PROGRAMME,
  /// ces 4 champs portent l'intention en attente de confirmation.
  paiementProgrammeCompteId String?   @map("paiement_programme_compte_id") @db.Uuid
  paiementProgrammeMontant  Decimal?  @map("paiement_programme_montant") @db.Decimal(14, 2)
  paiementProgrammePreuves  String[]  @default([]) @map("paiement_programme_preuves")
  paiementProgrammeDate     DateTime? @map("paiement_programme_date") @db.Timestamptz(6)

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pharmacie    Pharmacie           @relation(fields: [pharmacieId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  validePar    Profil?             @relation("FactureMensuelleValidee", fields: [valideParId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lignes       LigneDispensation[]
  paiementGroupeFactures PaiementGroupeFacture[]

  @@unique([pharmacieId, periode])
  @@index([organisationId])
  @@index([pharmacieId])
  @@index([statut])
  @@map("factures_mensuelles_pharmacie")
}

/// codes_ordonnance — 2e des 4 codes anti-fraude (v8 §3). Sa validation par une
/// pharmacie est le SEUL moment où le contenu de l'ordonnance lui est révélé.
/// prisma/sql/013.
model CodeOrdonnance {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId          String   @map("organisation_id") @db.Uuid
  ordonnanceId            String?  @map("ordonnance_id") @db.Uuid
  adherentId              String?  @map("adherent_id") @db.Uuid
  beneficiaireId          String?  @map("beneficiaire_id") @db.Uuid
  code                    String   @unique
  dateEmission            DateTime @default(now()) @map("date_emission") @db.Timestamptz(6)
  /// 7 → 14 jours (prisma/sql/040) — délai jugé trop court en pratique.
  dateExpiration          DateTime @default(dbgenerated("(now() + '14 days'::interval)")) @map("date_expiration") @db.Timestamptz(6)
  statut                  String   @default("EMIS") // EMIS | PRESENTE_PHARMACIE | UTILISE_PARTIEL | UTILISE_COMPLET | EXPIRE | ANNULE
  pharmacieUtilisatriceId String?  @map("pharmacie_utilisatrice_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordonnance   Ordonnance?   @relation(fields: [ordonnanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pharmacie    Pharmacie?    @relation(fields: [pharmacieUtilisatriceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adherent     Adherent?     @relation(fields: [adherentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  beneficiaire Beneficiaire? @relation(fields: [beneficiaireId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organisationId])
  @@index([adherentId])
  @@index([ordonnanceId])
  @@index([statut])
  @@map("codes_ordonnance")
}

/// tickets_soins — 3e des 4 codes anti-fraude (v8 §4). Un seul ticket par
/// dossier de soins ; créé et clôturé AUTOMATIQUEMENT avec le dossier (jamais
/// une étape manuelle). Trigger `verifier_ticket_ouvert()`. prisma/sql/014.
model TicketSoins {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dossierSoinsId String    @unique @map("dossier_soins_id") @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  code           String    @unique
  dateEmission   DateTime  @default(now()) @map("date_emission") @db.Timestamptz(6)
  dateCloture    DateTime? @map("date_cloture") @db.Timestamptz(6)
  statut         String    @default("OUVERT") // OUVERT | CLOTURE | ANNULE
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  dossier      DossierSoins    @relation(fields: [dossierSoinsId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actes        ActeDossier[]
  /// Plusieurs cycles de facturation possibles depuis prisma/sql/039 (facturation
  /// par sélection d'actes, paiement partiel) — plus une facture unique.
  factures     FactureDossier[]
  autorisationsRepetition AutorisationRepetitionActe[]

  @@index([statut])
  @@index([organisationId])
  @@map("tickets_soins")
}

/// actes_dossier — actes d'un épisode de soins (v1 §15). Rattachés à un
/// `ticket_soins` OUVERT (trigger). `medecin_prescripteur_id` = compte réel
/// (v10 §1.2). prisma/sql/014.
model ActeDossier {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dossierSoinsId        String    @map("dossier_soins_id") @db.Uuid
  ticketSoinsId         String    @map("ticket_soins_id") @db.Uuid
  consultationId        String?   @map("consultation_id") @db.Uuid
  medecinPrescripteurId String?   @map("medecin_prescripteur_id") @db.Uuid
  categorieActe         String    @map("categorie_acte")
  libelle               String
  codeActe              String?   @map("code_acte")
  /// Acte du référentiel de l'organisation (prisma/sql/080) — remplace la jointure par `code_acte`
  referentielActeId     String?   @map("referentiel_acte_id") @db.Uuid
  quantite              Int       @default(1)
  montantPrescrit       Decimal?  @map("montant_prescrit") @db.Decimal(14, 2)
  /// Simulation INDICATIVE calculée à l'ajout de l'acte (tarif conventionné si
  /// applicable × taux de couverture de la garantie) — le calcul définitif de
  /// l'adjudication (microservice Java) garde le dernier mot. NULL si l'acte
  /// n'a pas de codeActe renseigné/homologué (rien à simuler). prisma/sql/037.
  montantSimuleAssurance Decimal? @map("montant_simule_assurance") @db.Decimal(14, 2)
  montantSimulePatient   Decimal? @map("montant_simule_patient") @db.Decimal(14, 2)
  ticketModerateurSimule Decimal? @map("ticket_moderateur_simule") @db.Decimal(14, 2)
  /// Pré-autorisation obligatoire à DEUX niveaux pour les actes ANALYSES_
  /// EXAMENS_MEDICAUX/HOSPITALISATION_MEDICALE — forcée à EN_ATTENTE_
  /// EXPLOITATION côté serveur (jamais par le client) quand dossier.typeVisite
  /// le requiert. ASSUREUR_EXPLOITATION statue en premier (APPROUVE/REFUSE/
  /// ESCALADE_MEDECIN_CONSEIL) ; seule l'escalade fait passer à EN_ATTENTE_
  /// MEDECIN_CONSEIL. Tant que EN_ATTENTE_* ou REFUSEE, l'acte est exclu de
  /// toute facturation/paiement (v3 §5 étendu). prisma/sql/038, prisma/sql/041.
  statutPreautorisation String    @default("NON_REQUISE") @map("statut_preautorisation") // NON_REQUISE | EN_ATTENTE_EXPLOITATION | EN_ATTENTE_MEDECIN_CONSEIL | APPROUVEE | APPROUVEE_PARTIELLEMENT | REFUSEE
  /// Approbation partielle par l'exploitation ou le médecin conseil (ex. 2
  /// jours accordés sur 3 demandés — `quantite` reste la quantité DEMANDÉE,
  /// inchangée) ou changement de nature de l'acte approuvé (ex. « mise en
  /// observation » à la place d'une hospitalisation). NULL tant que non
  /// approuvé, ou si l'approbation est intégrale. prisma/sql/041.
  quantiteApprouvee      Int?      @map("quantite_approuvee")
  typeActeApprouve       String?   @map("type_acte_approuve")
  /// Surcharge du ticket modérateur pour CET acte précis uniquement (jamais
  /// la garantie elle-même, ni les autres actes du dossier) — utilisée en
  /// priorité sur `garanties.ticketModerateur` si renseignée. prisma/sql/041.
  ticketModerateurAjuste Decimal?  @map("ticket_moderateur_ajuste") @db.Decimal(5, 2)
  /// Orientation vers un établissement EXÉCUTANT distinct de celui d'origine
  /// (`dossier.etablissementId`) — renseigné par ASSUREUR_EXPLOITATION au
  /// moment de l'approbation. Une fois renseigné, le tarif conventionné
  /// (`simulerMontantActe`) est recherché pour CET établissement, jamais plus
  /// celui d'origine. prisma/sql/042.
  etablissementExecutionId String? @map("etablissement_execution_id") @db.Uuid
  /// tarif conventionné appliqué au calcul (facture, simulation, adjudication) — prisma/sql/074
  tarifConventionneId   String?   @map("tarif_conventionne_id") @db.Uuid
  statut                String    @default("PRESCRIT") // PRESCRIT | REALISE | ANNULE | LIQUIDE
  datePrescription      DateTime  @default(now()) @map("date_prescription") @db.Timestamptz(6)
  dateRealisation       DateTime? @map("date_realisation") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  dossier      DossierSoins         @relation(fields: [dossierSoinsId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ticket       TicketSoins          @relation(fields: [ticketSoinsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categorie    CategorieActe        @relation(fields: [categorieActe], references: [code], onDelete: NoAction, onUpdate: NoAction)
  consultation ConsultationDossier? @relation(fields: [consultationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prescripteur Profil?              @relation(fields: [medecinPrescripteurId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  etablissementExecution EtablissementSante? @relation("ActeEtablissementExecution", fields: [etablissementExecutionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lignesFacturation LigneFacturation[]
  notes NoteDossier[]
  contestations ContestationActe[]
  tarifConventionne TarifConventionne? @relation("ActeTarifConventionne", fields: [tarifConventionneId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  referentielActe ReferentielActe? @relation(fields: [referentielActeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([dossierSoinsId])
  @@index([ticketSoinsId])
  @@index([statut])
  @@map("actes_dossier")
}

/// Autorisation à usage unique du médecin conseil débloquant la règle
/// anti-répétition (14 jours) pour UN acte précis d'ANALYSES_EXAMENS_MEDICAUX
/// sur UN ticket de soins précis (même code d'acte) — voir
/// `PreauthorizationService.autoriserRepetition`/`ajouterActe`. prisma/sql/042.
/// Autorisation à usage unique du médecin conseil débloquant une règle de
/// répétition — soit un acte précis (`codeActe` non nul), soit un TYPE de
/// visite entier (`typeVisite` non nul, règle de fréquence des consultations,
/// prisma/sql/045) — exactement l'un des deux, jamais les deux ni aucun.
model AutorisationRepetitionActe {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  ticketSoinsId  String    @map("ticket_soins_id") @db.Uuid
  codeActe       String?   @map("code_acte")
  typeVisite     String?   @map("type_visite")
  motif          String
  autoriseParId  String    @map("autorise_par_id") @db.Uuid
  utilisee       Boolean   @default(false)
  utiliseeLe     DateTime? @map("utilisee_le") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket       TicketSoins  @relation(fields: [ticketSoinsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  autorisePar  Profil       @relation(fields: [autoriseParId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organisationId])
  @@index([ticketSoinsId, codeActe])
  @@index([ticketSoinsId, typeVisite])
  @@map("autorisations_repetition_acte")
}

/// Note libre d'ASSUREUR_EXPLOITATION(_CONJOINTE)/ASSUREUR_MEDECIN_CONSEIL sur
/// un dossier de soins (ou un acte précis, `acteDossierId` nullable) — visible
/// dans l'historique du dossier par tous les rôles qui y ont déjà accès en
/// lecture (`CareEpisodeService.modeLectureDossiers`). prisma/sql/042.
model NoteDossier {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  dossierSoinsId String   @map("dossier_soins_id") @db.Uuid
  acteDossierId  String?  @map("acte_dossier_id") @db.Uuid
  auteurId       String   @map("auteur_id") @db.Uuid
  contenu        String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dossier      DossierSoins @relation(fields: [dossierSoinsId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  acte         ActeDossier? @relation(fields: [acteDossierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auteur       Profil       @relation(fields: [auteurId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organisationId])
  @@index([dossierSoinsId])
  @@map("notes_dossier")
}

/// factures_dossier — 4e des 4 codes anti-fraude (v8 §5). Le règlement est
/// IMPOSSIBLE tant que l'adhérent n'a pas validé `code_facturation` (garde
/// applicative + trigger). prisma/sql/015.
///
/// DEPUIS prisma/sql/039 : un dossier peut avoir PLUSIEURS cycles de
/// facturation successifs (facturation par sélection d'actes, paiement
/// partiel) — `ticketSoinsId` n'est donc plus `@unique`. Chaque ligne
/// représente UN cycle (un code, une sélection d'actes, un règlement) ; le
/// détail acte par acte vit dans `LigneFacturation`.
model FactureDossier {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId        String    @map("organisation_id") @db.Uuid
  dossierSoinsId        String    @map("dossier_soins_id") @db.Uuid
  ticketSoinsId         String    @map("ticket_soins_id") @db.Uuid
  etablissementId       String    @map("etablissement_id") @db.Uuid
  adherentId            String?   @map("adherent_id") @db.Uuid
  beneficiaireId        String?   @map("beneficiaire_id") @db.Uuid
  montantTotal          Decimal   @default(0) @map("montant_total") @db.Decimal(14, 2)
  montantAssurance      Decimal   @default(0) @map("montant_assurance") @db.Decimal(14, 2)
  montantPatient        Decimal   @default(0) @map("montant_patient") @db.Decimal(14, 2)
  statut                String    @default("EMISE") // EMISE | EN_VALIDATION | VALIDEE | REGLEE | CONTESTEE
  codeFacturation       String?   @unique @map("code_facturation")
  codeValideParPatient  Boolean   @default(false) @map("code_valide_par_patient")
  dateValidationPatient DateTime? @map("date_validation_patient") @db.Timestamptz(6)
  dateReglement         DateTime? @map("date_reglement") @db.Timestamptz(6)
  reglePar              String?   @map("regle_par") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dossier        DossierSoins       @relation(fields: [dossierSoinsId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ticket         TicketSoins        @relation(fields: [ticketSoinsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  etablissement  EtablissementSante @relation(fields: [etablissementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  regleParProfil Profil?            @relation(fields: [reglePar], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adherent       Adherent?          @relation(fields: [adherentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  beneficiaire   Beneficiaire?      @relation(fields: [beneficiaireId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lignesFacturation LigneFacturation[]

  @@index([organisationId])
  @@index([adherentId])
  @@index([etablissementId])
  @@index([statut])
  @@index([ticketSoinsId])
  @@map("factures_dossier")
}

/// lignes_facturation — détail acte par acte d'un cycle de facturation
/// (facturation par sélection d'actes, paiement partiel, prisma/sql/039).
/// `factureDossierId` nullable : une ligne « réclame » un acte pour un cycle,
/// mais reste rattachable/ré-attachable à un cycle (ex. un acte resélectionné
/// après un cycle abandonné avant validation réutilise sa ligne A_PAYER
/// existante plutôt que d'en dupliquer une). Au plus UNE ligne A_PAYER par
/// acte à la fois (index unique partiel, prisma/sql/039).
model LigneFacturation {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  factureDossierId String?   @map("facture_dossier_id") @db.Uuid
  acteDossierId    String    @map("acte_dossier_id") @db.Uuid
  montantReclame   Decimal   @map("montant_reclame") @db.Decimal(14, 2)
  statut           String    @default("A_PAYER") @map("statut") // A_PAYER | PAYE
  datePaiement     DateTime? @map("date_paiement") @db.Timestamptz(6)
  /// Consolidation mensuelle établissement (prisma/sql/047) — même principe que
  /// `lignes_dispensation.facture_mensuelle_id` côté pharmacie : « réclame »
  /// une ligne PAYE pour une facture mensuelle précise, snapshot à la soumission.
  factureMensuelleEtablissementId String? @map("facture_mensuelle_etablissement_id") @db.Uuid
  /// Décochée manuellement (`decocherLigneContestee`, prisma/sql/048) ou exclue
  /// automatiquement pour litige — candidate à la réintégration automatique dès
  /// que la contestation associée n'est plus en litige (VALIDEE) ; reste
  /// définitivement non réclamée si REJETEE.
  reporteeMoisSuivant Boolean @default(false) @map("reportee_mois_suivant")
  /// Instantané du tarif appliqué, FIGÉ à l'émission (prisma/sql/082, ADR-008 lot 3) : valeurs copiées du
  /// calcul du microservice, jamais recalculées (trigger : non modifiables une fois posées).
  tarifStatut            String?  @map("tarif_statut") // TARIFABLE | NON_APPLICABLE
  tarifRegleOrigine      String?  @map("tarif_regle_origine") // FORFAIT | VALEUR_PROPRE | VALEUR_LETTRE_CLE | AUCUNE_CONVENTION
  tarifLettreCle         String?  @map("tarif_lettre_cle")
  tarifCoefficient       Decimal? @map("tarif_coefficient") @db.Decimal(8, 2)
  tarifValeurAppliquee   Decimal? @map("tarif_valeur_appliquee") @db.Decimal(14, 2)
  tarifConventionId      String?  @map("tarif_convention_id") @db.Uuid
  tarifPolitiqueDepassement String? @map("tarif_politique_depassement") // PATIENT | REJET
  tarifPrixAffiche       Decimal? @map("tarif_prix_affiche") @db.Decimal(14, 2)
  tarifReconnu           Decimal? @map("tarif_reconnu") @db.Decimal(14, 2)
  tarifEcart             Decimal? @map("tarif_ecart") @db.Decimal(14, 2)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tarifConvention Convention? @relation(fields: [tarifConventionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  factureDossier FactureDossier? @relation(fields: [factureDossierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  acteDossier    ActeDossier     @relation(fields: [acteDossierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  factureMensuelleEtablissement FactureMensuelleEtablissement? @relation(fields: [factureMensuelleEtablissementId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organisationId])
  @@index([factureDossierId])
  @@index([acteDossierId])
  @@index([statut])
  @@index([factureMensuelleEtablissementId])
  @@map("lignes_facturation")
}

/// factures_mensuelles_etablissement — miroir de FactureMensuellePharmacie pour
/// l'établissement (centre médical) : consolidation mensuelle des LigneFacturation
/// déjà PAYE (patient a confirmé + réglé son code de facturation, même principe
/// que dispensations_pharmacie.statut = PAYEE) en un cycle de paiement unique
/// assureur → établissement. prisma/sql/047.
model FactureMensuelleEtablissement {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  etablissementId   String    @map("etablissement_id") @db.Uuid
  /// Premier jour du mois concerné (ex. 2026-08-01 pour août 2026).
  periode           DateTime  @db.Date
  montantTotal      Decimal   @default(0) @map("montant_total") @db.Decimal(14, 2)
  statut            String    @default("EN_PREPARATION") // EN_PREPARATION | SOUMISE | VERIFIEE_MEDECIN_CONSEIL | PROGRAMMEE_PAIEMENT | PAYEE
  dateSoumission    DateTime? @map("date_soumission") @db.Timestamptz(6)
  verifieParId      String?   @map("verifie_par_id") @db.Uuid
  dateVerification  DateTime? @map("date_verification") @db.Timestamptz(6)
  dateProgrammation DateTime? @map("date_programmation") @db.Timestamptz(6)
  datePaiement      DateTime? @map("date_paiement") @db.Timestamptz(6)
  /// Nombre de lignes décochées pour litige depuis cette facture (prisma/sql/048,
  /// `decocherLigneContestee`) — distingue une facture PAYEE intégralement d'une
  /// facture PAYEE mais partiellement réglée (certaines lignes reportées).
  nbLignesReportees Int       @default(0) @map("nb_lignes_reportees")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Paiement RÉEL (prisma/sql/051, `PaymentService.payerFacture`) — voir
  /// `FactureMensuellePharmacie.montantPaye` pour le détail des 5 champs.
  montantPaye Decimal @default(0) @map("montant_paye") @db.Decimal(14, 2)
  paiementProgrammeCompteId String?   @map("paiement_programme_compte_id") @db.Uuid
  paiementProgrammeMontant  Decimal?  @map("paiement_programme_montant") @db.Decimal(14, 2)
  paiementProgrammePreuves  String[]  @default([]) @map("paiement_programme_preuves")
  paiementProgrammeDate     DateTime? @map("paiement_programme_date") @db.Timestamptz(6)

  organisation  Organisation       @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  etablissement EtablissementSante @relation(fields: [etablissementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  verifiePar    Profil?            @relation("FactureMensuelleEtablissementVerifiee", fields: [verifieParId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lignes        LigneFacturation[]
  paiementGroupeFactures PaiementGroupeFacture[]

  @@unique([etablissementId, periode])
  @@index([organisationId])
  @@index([etablissementId])
  @@index([statut])
  @@map("factures_mensuelles_etablissement")
}

/// paiements_groupes — regroupe plusieurs factures mensuelles VALIDEES (statut
/// PROGRAMMEE_PAIEMENT) du MÊME bénéficiaire (un établissement OU une pharmacie,
/// jamais mélangés) en un paiement unique programmé. `beneficiaireId` référence
/// `etablissements_sante.id` ou `pharmacies.id` selon `beneficiaireType` — pas de
/// FK directe possible (référence polymorphe), validée côté service. prisma/sql/048.
model PaiementGroupe {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  beneficiaireType String    @map("beneficiaire_type") // ETABLISSEMENT | PHARMACIE
  beneficiaireId   String    @map("beneficiaire_id") @db.Uuid
  montantTotal     Decimal   @default(0) @map("montant_total") @db.Decimal(14, 2)
  dateProgrammee   DateTime  @default(now()) @map("date_programmee") @db.Timestamptz(6)
  datePaiement     DateTime? @map("date_paiement") @db.Timestamptz(6)
  statut           String    @default("PROGRAMME") // PROGRAMME | PAIEMENT_PROGRAMME | PAYE
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Paiement RÉEL programmé à une date future (`PaymentService.payerFacture`,
  /// prisma/sql/051) — pas de montant distinct : toujours `montantTotal`
  /// (paiement de groupe intégral uniquement, jamais partiel).
  paiementProgrammeCompteId String?   @map("paiement_programme_compte_id") @db.Uuid
  paiementProgrammePreuves  String[]  @default([]) @map("paiement_programme_preuves")
  paiementProgrammeDate     DateTime? @map("paiement_programme_date") @db.Timestamptz(6)

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  factures     PaiementGroupeFacture[]

  @@index([organisationId])
  @@index([beneficiaireType, beneficiaireId])
  @@index([statut])
  @@map("paiements_groupes")
}

/// Table de liaison — exactement l'une des deux FK non nulle (établissement OU
/// pharmacie), même pattern que `AutorisationRepetitionActe` (codeActe/typeVisite).
model PaiementGroupeFacture {
  id                              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paiementGroupeId                String  @map("paiement_groupe_id") @db.Uuid
  factureMensuelleEtablissementId String? @map("facture_mensuelle_etablissement_id") @db.Uuid
  factureMensuellePharmacieId     String? @map("facture_mensuelle_pharmacie_id") @db.Uuid

  paiementGroupe                PaiementGroupe                 @relation(fields: [paiementGroupeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  factureMensuelleEtablissement  FactureMensuelleEtablissement? @relation(fields: [factureMensuelleEtablissementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  factureMensuellePharmacie      FactureMensuellePharmacie?     @relation(fields: [factureMensuellePharmacieId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([paiementGroupeId])
  @@map("paiements_groupes_factures")
}

/// comptes_financiers — socle des comptes financiers de l'assureur (trésorerie
/// interne : comptes bancaires + caisses internes). Écriture (ET lecture)
/// strictement réservées au rôle EXACT ASSUREUR_COMPTABLE — JAMAIS
/// ASSUREUR_COMPTABLE_ADJOINT (voir `payment.types.ts`,
/// ROLES_GESTION_COMPTES_FINANCIERS, pour le détail du piège d'héritage
/// évité). prisma/sql/049.
model CompteFinancier {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  type           String // BANCAIRE | CAISSE_INTERNE
  nom            String
  banqueNom      String?   @map("banque_nom")
  numeroCompte   String?   @map("numero_compte")
  soldeActuel    Decimal   @default(0) @map("solde_actuel") @db.Decimal(14, 2)
  /// ACTIF | ARCHIVE — archivage réversible (prisma/sql/077) ; le solde ne se modifie jamais directement
  statut         String    @default("ACTIF")
  creeParId      String    @map("cree_par") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creePar      Profil       @relation(fields: [creeParId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mouvementsSource      MouvementFinancier[] @relation("MouvementCompteSource")
  mouvementsDestination MouvementFinancier[] @relation("MouvementCompteDestination")

  @@index([organisationId])
  @@map("comptes_financiers")
}

/// mouvements_financiers — table d'audit IMMUABLE (insert-only, jamais de
/// update/delete) des mouvements de trésorerie entre comptes financiers et des
/// dépenses courantes. `type` détermine quelle FK compte est nulle :
/// TRANSFERT (source + destination toutes deux renseignées), DEPENSE (source
/// seule — sort de l'organisation), APPROVISIONNEMENT (destination seule —
/// alimenté par `PaymentService.approvisionnerCompte`, source renseignée en
/// plus si la source est un autre compte), PAIEMENT_FACTURE (réservé à une
/// intégration future avec le règlement des paiements groupés — non encore
/// émis par aucun flux). prisma/sql/050.
model MouvementFinancier {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  compteSourceId      String?   @map("compte_source_id") @db.Uuid
  compteDestinationId String?   @map("compte_destination_id") @db.Uuid
  type                String // TRANSFERT | DEPENSE | APPROVISIONNEMENT | PAIEMENT_FACTURE
  montant             Decimal   @db.Decimal(14, 2)
  description         String
  pieceJointeUrl      String?   @map("piece_jointe_url")
  effectueParId       String    @map("effectue_par") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation      Organisation     @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  compteSource      CompteFinancier? @relation("MouvementCompteSource", fields: [compteSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  compteDestination CompteFinancier? @relation("MouvementCompteDestination", fields: [compteDestinationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  effectuePar       Profil           @relation(fields: [effectueParId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organisationId])
  @@index([compteSourceId])
  @@index([compteDestinationId])
  @@map("mouvements_financiers")
}

/// licences_organisation — administration SaaS (v14 §5). Une licence par tenant.
/// prisma/sql/016.
model LicenceOrganisation {
  organisationId      String    @id @map("organisation_id") @db.Uuid
  plan                String    @default("STARTER") // STARTER | BUSINESS | ENTERPRISE
  limiteAdherents     Int?      @map("limite_adherents")
  limiteAppelsApiMois Int?      @map("limite_appels_api_mois")
  dateDebut           DateTime  @default(dbgenerated("CURRENT_DATE")) @map("date_debut") @db.Date
  dateFin             DateTime? @map("date_fin") @db.Date
  statut              String    @default("ACTIVE") // ACTIVE | SUSPENDUE | EXPIREE
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([statut])
  @@map("licences_organisation")
}

/// codes_validation_superadmin — confirmation à deux temps des actions
/// sensibles du superadmin (v14 §5, PROMPT 22). Le code est envoyé par e-mail à
/// SUPERADMIN_EMAIL ; validité 15 min, usage unique. prisma/sql/016.
model CodeValidationSuperadmin {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action         String // CREATION_ORGANISATION | SUSPENSION_ORGANISATION | PROLONGATION_ORGANISATION
  payload        Json
  code           String   @unique
  dateEmission   DateTime @default(now()) @map("date_emission") @db.Timestamptz(6)
  dateExpiration DateTime @default(dbgenerated("(now() + '00:15:00'::interval)")) @map("date_expiration") @db.Timestamptz(6)
  statut         String   @default("EMIS") // EMIS | CONFIRME | EXPIRE | ANNULE
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([statut])
  @@map("codes_validation_superadmin")
}

/// parametres_plateforme — configuration globale de la plateforme (v1 §10.4,
/// PROMPT 23). Devises, pays/villes, taux de taxe, langues. Lecture ET écriture
/// EXCLUSIVEMENT SUPERADMIN_PRINCIPAL. prisma/sql/017.
model ParametrePlateforme {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cle         String   @unique
  valeur      Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("parametres_plateforme")
}

/// referentiel_national_actes — catalogue national partagé des actes (v1 §10.4,
/// PROMPT 23). Mêmes colonnes que `referentiel_actes` SANS organisation_id.
/// Maintenu EXCLUSIVEMENT par SUPERADMIN_PRINCIPAL ; ASSUREUR_INFORMATIQUE
/// l'importe vers le référentiel de SON organisation au statut PROPOSE. prisma/sql/017.
model ReferentielNationalActe {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String // unique parmi les non supprimés : index partiel (prisma/sql/074)
  libelle             String
  categorie           String?
  versionNomenclature String?   @map("version_nomenclature")
  statut              String    @default("HOMOLOGUE") // PROPOSE | HOMOLOGUE | SUSPENDU | RETIRE
  homologuePar        String?   @map("homologue_par") @db.Uuid
  dateHomologation    DateTime? @map("date_homologation") @db.Timestamptz(6)
  dateRetrait         DateTime? @map("date_retrait") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// Cotation (prisma/sql/080) : lettre-clé + coefficient (aucun prix en FCFA ici), mode isolé / groupé,
  /// catégorie de GARANTIE (distincte du chapitre `categorie`), code de groupe.
  lettreCleCode       String?   @map("lettre_cle_code")
  coefficient         Decimal?  @db.Decimal(8, 2)
  modeCotation        String    @default("ISOLE") @map("mode_cotation") // ISOLE | GROUPE
  categorieGarantie   String?   @map("categorie_garantie")
  groupeCode          String?   @map("groupe_code")

  lettreCle           LettreCle?     @relation(fields: [lettreCleCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  categorieGarantieRef CategorieActe? @relation("ReferentielNationalActeCategorieGarantie", fields: [categorieGarantie], references: [code], onDelete: Restrict, onUpdate: Cascade)
  @@index([statut])
  @@map("referentiel_national_actes")
}

/// referentiel_national_medicaments — catalogue national partagé des médicaments
/// (v1 §10.4, PROMPT 23). Mêmes colonnes que `medicaments` SANS organisation_id.
model ReferentielNationalMedicament {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  denominationCommune   String    @map("denomination_commune")
  nomCommercial         String?   @map("nom_commercial")
  codeEan               String?   @map("code_ean")
  forme                 String?
  dosage                String?
  conditionnement       String?
  classeTherapeutique   String?   @map("classe_therapeutique")
  remboursable          Boolean   @default(false)
  tauxRemboursementStd  Decimal?  @map("taux_remboursement_std") @db.Decimal(5, 2)
  prixReferenceXof      Decimal?  @map("prix_reference_xof") @db.Decimal(14, 2)
  prixMaxRemboursable   Decimal?  @map("prix_max_remboursable") @db.Decimal(14, 2)
  medicamentEssentiel   Boolean   @default(false) @map("medicament_essentiel")
  generiqueDisponible   Boolean?  @map("generique_disponible")
  ordonnanceObligatoire Boolean   @default(true) @map("ordonnance_obligatoire")
  medicamentControle    Boolean   @default(false) @map("medicament_controle")
  usage                 String?
  statutHomologation    String    @default("HOMOLOGUE") @map("statut_homologation")
  homologuePar          String?   @map("homologue_par") @db.Uuid
  dateHomologation      DateTime? @map("date_homologation") @db.Timestamptz(6)
  dateRetrait           DateTime? @map("date_retrait") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// Liste des médicaments remboursables (CMU / MUGEF-CI) — prisma/sql/079
  codeProduit           String?   @map("code_produit")
  categorieRemboursement String?  @map("categorie_remboursement") // R | EP (entente préalable)
  regimeRemboursement   String?   @map("regime_remboursement")
  sourceListe           String?   @map("source_liste")

  @@index([statutHomologation])
  @@map("referentiel_national_medicaments")
}

/// imports_catalogue_national — import en masse par Excel du catalogue national
/// (referentiel_national_actes/medicaments), réservé EXCLUSIVEMENT à
/// SUPERADMIN_PRINCIPAL. Pas d'organisation_id (cross-tenant, comme les tables
/// ci-dessus). Même pattern que ImportAdherents (prisma/sql/053) : import et
/// validation séparés, mais PAS de double validation ici — un seul et même
/// rôle (SUPERADMIN_PRINCIPAL) importe ET valide. prisma/sql/057.
model ImportCatalogueNational {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            String // ACTES | MEDICAMENTS
  fichierNom      String    @map("fichier_nom")
  statut          String    @default("EN_ATTENTE_VALIDATION") // EN_ATTENTE_VALIDATION | VALIDE | REJETE
  nbLignesTotal   Int       @map("nb_lignes_total")
  nbLignesValides Int       @map("nb_lignes_valides")
  nbLignesErreur  Int       @map("nb_lignes_erreur")
  /// Lignes déjà validées — `{code/libelle/categorie, estMiseAJour, idExistant}`
  /// (ACTES) ou `{denominationCommune, nomCommercial, classeTherapeutique,
  /// prixReferenceXof, medicamentEssentiel, estMiseAJour, idExistant}`
  /// (MEDICAMENTS). `estMiseAJour` distingue une mise à jour d'un doublon déjà
  /// existant (jamais une erreur bloquante) d'une nouvelle entrée.
  lignesValides   Json      @map("lignes_valides")
  /// Array JSON {ligne, donnees, erreurs[]} — une entrée par ligne rejetée.
  erreursDetail   Json      @map("erreurs_detail")
  importeParId    String    @map("importe_par") @db.Uuid
  valideParId     String?   @map("valide_par") @db.Uuid
  dateValidation  DateTime? @map("date_validation") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  importePar Profil  @relation("ImportCatalogueNationalImportePar", fields: [importeParId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  validePar  Profil? @relation("ImportCatalogueNationalValidePar", fields: [valideParId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([type])
  @@index([statut])
  @@map("imports_catalogue_national")
}

/// reclamations — une réclamation par acte de dossier (unique sur acte_dossier_id).
/// Machine à états SOUMISE → EN_ADJUDICATION → AUTO_ADJUDIQUE / REVUE_MANUELLE →
/// REJETE / PAYEE (v1 §16, v8). Écriture : NestJS (postgres) + svc_adjudication
/// (UPDATE statut uniquement). prisma/sql/018.
/// Deux sources possibles depuis prisma/sql/040 (exactement l'une des deux,
/// CHECK en base) : un acte établissement (`acteDossierId`, historique), ou
/// une dispensation pharmacie payée (`dispensationId` — « une dispensation
/// payée = un remboursement réclamé », montant cumulé sur toutes ses lignes,
/// jamais un flux séparé sans lien avec l'adjudication).
model Reclamation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  dossierSoinsId  String    @map("dossier_soins_id") @db.Uuid
  acteDossierId   String?   @map("acte_dossier_id") @db.Uuid
  dispensationId  String?   @map("dispensation_id") @db.Uuid
  adherentId      String?   @map("adherent_id") @db.Uuid
  beneficiaireId  String?   @map("beneficiaire_id") @db.Uuid
  policeId        String    @map("police_id") @db.Uuid
  /// NULL uniquement pour un rejet E011 « catégorie non couverte par le
  /// produit » (contrainte reclamations_garantie_ou_non_couverte, prisma/sql/067).
  garantieId      String?   @map("garantie_id") @db.Uuid
  montant         Decimal   @db.Decimal(14, 2)
  typeReclamation String    @map("type_reclamation") // SOIN | PHARMACIE | HOSPITALISATION | OPTIQUE | DENTAIRE | ANALYSES | IMAGERIE | AUTRE
  statut          String    @default("SOUMISE") // SOUMISE | EN_ADJUDICATION | AUTO_ADJUDIQUE | REVUE_MANUELLE | REJETE | PAYEE
  codesRejet      String[]  @map("codes_rejet")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  remboursement Remboursement?
  adherent      Adherent?              @relation(fields: [adherentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  beneficiaire  Beneficiaire?          @relation(fields: [beneficiaireId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dispensation  DispensationPharmacie? @relation(fields: [dispensationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  garantie      Garantie?              @relation(fields: [garantieId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organisationId])
  @@index([statut])
  @@index([dossierSoinsId])
  @@index([dispensationId])
  @@map("reclamations")
}

/// remboursements — résultat d'adjudication, une ligne par réclamation.
/// INSERT-only pour svc_adjudication ; jamais mis à jour. prisma/sql/018.
model Remboursement {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reclamationId       String   @unique @map("reclamation_id") @db.Uuid
  montantRembourse    Decimal  @map("montant_rembourse") @db.Decimal(14, 2)
  plafondRestantApres Decimal? @map("plafond_restant_apres") @db.Decimal(14, 2)
  decision            String
  dureeTraitementMs   Int?     @map("duree_traitement_ms")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reclamation Reclamation @relation(fields: [reclamationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("remboursements")
}

/// Inscriptions newsletter de la page d'accueil publique (prisma/sql/059).
/// Pas d'organisation_id : page commune à la plateforme. Email en minuscules, unique.
model NewsletterAbonne {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String    @unique(map: "newsletter_abonnes_email_unique")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("newsletter_abonnes")
}

/// Événements de la vitrine (carrousel du bloc « Qui sommes-nous »), gérés par
/// ASSUREUR_INFORMATIQUE — prisma/sql/060. Statut PASSE/A_VENIR calculé à la
/// lecture, jamais stocké. `organisationId` : clé étrangère SQL, sans relation
/// Prisma (lecture/écriture toujours filtrées par l'organisation de l'appelant).
model Evenement {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  titre          String
  description    String?
  imageUrl       String    @map("image_url")
  dateEvenement  DateTime  @map("date_evenement") @db.Date
  ordreAffichage Int       @default(0) @map("ordre_affichage")
  actif          Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("evenements")
}

/// Demandes du formulaire « Adhésion » de la page d'accueil — prisma/sql/064.
/// Enregistrées AVANT l'envoi de l'e-mail (jamais perdues s'il échoue).
/// `organisationId` / `traitePar` : clés étrangères SQL, sans relation Prisma
/// (même principe que `Evenement`).
model DemandeAdhesion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String?   @map("organisation_id") @db.Uuid
  nomSociete     String    @map("nom_societe")
  nombreEstime   Int       @map("nombre_estime")
  email          String
  telephone      String
  objet          String
  message        String?
  statut         String    @default("NOUVEAU") // NOUVEAU | TRAITE
  emailEnvoye    Boolean?  @map("email_envoye")
  traitePar      String?   @map("traite_par") @db.Uuid
  traiteLe       DateTime? @map("traite_le") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([organisationId, statut, createdAt(sort: Desc)], map: "demandes_adhesion_organisation_idx")
  @@map("demandes_adhesion")
}
