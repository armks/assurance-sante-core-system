// Prisma schema — apps/api
// ---------------------------------------------------------------------------
// Synchronisé avec la base Supabase existante via `npx prisma db pull`
// (dernière synchro : 2026-09-09, après PROMPT 10). Les colonnes ci-dessous
// reflètent la base RÉELLE (schéma `public`). Modèles renommés en PascalCase +
// `@@map` vers les tables snake_case. `@updatedAt` géré côté app (aucun trigger).
//
// Schéma `auth` (Supabase GoTrue) : NON modélisé. `profils.id` référence
// `auth.users(id)` en base ; l'email/identité provient du JWT vérifié.
// Ré-introspecter : ajouter `schemas = ["auth", "public"]`, `db pull --force`,
// puis retirer les modèles/enums `auth` et l'entrée `schemas`.
//
// DDL manuel appliqué (pas de `prisma migrate`) : voir prisma/sql/.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// organisations — tenant racine (compagnie d'assurance / mutuelle). v9 §0.1.
model Organisation {
  id               String    @id @db.Uuid
  nom              String
  raisonSociale    String?   @map("raison_sociale")
  type             String // ASSUREUR | MUTUELLE
  pays             String
  devise           String    @default("XOF")
  emailContact     String?   @map("email_contact")
  telephoneContact String?   @map("telephone_contact")
  statut           String    @default("ACTIVE") // ACTIVE | SUSPENDUE | ARCHIVEE
  /// URL publique du logo (bucket `logos`, prisma/sql/058) — null : carte sans logo.
  logoUrl          String?   @map("logo_url")
  /// Chemin de la page d'accueil dédiée (/{slug}) — prisma/sql/061. Unique,
  /// généré depuis `nom`, modifiable par SUPERADMIN_PRINCIPAL.
  slug             String // unique parmi les non supprimés : index partiel (prisma/sql/074)
  /// Bannière de la page /{slug} (prisma/sql/062) — ASSUREUR_INFORMATIQUE ; null :
  /// valeur par défaut de la plateforme.
  heroTitre        String?   @map("hero_titre")
  heroSousTitre    String?   @map("hero_sous_titre")
  heroImageUrl     String?   @map("hero_image_url")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  profils           Profil[]
  auditLogs         AuditLog[]
  souscripteurs     Souscripteur[]
  adherents         Adherent[]
  produits          Produit[]
  polices           Police[]
  grillesTarifaires GrilleTarifaire[]
  invitations       Invitation[]
  etablissements    EtablissementSante[]
  pharmacies        Pharmacie[]
  referentielActes  ReferentielActe[]
  tarifsConventionnes TarifConventionne[]
  medicaments       Medicament[]
  dossiersSoins     DossierSoins[]
  codesConsultation CodeConsultation[]
  ordonnances       Ordonnance[]
  codesOrdonnance   CodeOrdonnance[]
  ticketsSoins      TicketSoins[]
  facturesDossier   FactureDossier[]
  lignesFacturation LigneFacturation[]
  licence           LicenceOrganisation?
  autorisationsRepetitionActe AutorisationRepetitionActe[]
  notesDossier      NoteDossier[]
  contestationsPrescription ContestationPrescription[]
  contestationsActe ContestationActe[]
  facturesMensuellesPharmacie FactureMensuellePharmacie[]
  facturesMensuellesEtablissement FactureMensuelleEtablissement[]
  paiementsGroupes PaiementGroupe[]
  comptesFinanciers CompteFinancier[]
  mouvementsFinanciers MouvementFinancier[]
  importsAdherents ImportAdherents[]

  @@map("organisations")
}

/// audit_log — journal d'audit unique (alimenté par log_audit(), v9 §1.6). Append-only.
model AuditLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId   String?  @map("organisation_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  action           String
  tableCible       String   @map("table_cible")
  enregistrementId String?  @map("enregistrement_id") @db.Uuid
  details          Json?
  createdAt        DateTime @default(now()) @map("created_at")

  organisation Organisation? @relation(fields: [organisationId], references: [id])

  @@map("audit_log")
}

/// entites_metier — entité métier d'affichage. v9 §2.
model EntiteMetier {
  code    String @id
  libelle String

  sousRoles SousRole[]

  @@map("entites_metier")
}

/// sous_roles — dictionnaire des 25 sous-rôles avec héritage (role_parent_code). v9 addendum A.
model SousRole {
  code           String  @id
  entiteCode     String  @map("entite_code")
  libelle        String
  roleParentCode String? @map("role_parent_code")
  niveauAcces    String  @map("niveau_acces") // LECTURE_SEULE | MODIFICATION | ADMIN
  peutValider    Boolean @default(false) @map("peut_valider")
  dashboardRoute String  @map("dashboard_route")

  entite       EntiteMetier @relation(fields: [entiteCode], references: [code])
  roleParent   SousRole?    @relation("HierarchieSousRole", fields: [roleParentCode], references: [code])
  rolesEnfants SousRole[]   @relation("HierarchieSousRole")
  profils      Profil[]

  reglesCommeCreateur   RegleProvisioning[] @relation("RegleCreateur")
  reglesCommeCree       RegleProvisioning[] @relation("RegleCree")
  reglesCommeValidateur RegleProvisioning[] @relation("RegleValidateur")

  @@map("sous_roles")
}

/// profils — profil applicatif. `id` = auth.users.id. RLS INSERT : prisma/sql/003.
model Profil {
  id                 String    @id @db.Uuid
  organisationId     String?   @map("organisation_id") @db.Uuid
  role               String?
  societeId          String?   @map("societe_id") @db.Uuid
  etablissementId    String?   @map("etablissement_id") @db.Uuid
  pharmacieId        String?   @map("pharmacie_id") @db.Uuid
  adherentId         String?   @map("adherent_id") @db.Uuid
  mfaActive          Boolean?  @default(false) @map("mfa_active")
  methodeConnexion   String?   @map("methode_connexion") // EMAIL_MDP | SSO_GOOGLE | SSO_MICROSOFT | OTP_SMS
  numeroOrdreMedecin String?   @map("numero_ordre_medecin")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// Compte DÉSACTIVÉ (archivage de son établissement / pharmacie / société) — rétabli à la main (prisma/sql/075)
  desactiveLe        DateTime? @map("desactive_le") @db.Timestamptz(6)
  desactiveMotif     String?   @map("desactive_motif")
  /// ACTIF | REVOQUE — révocation MANUELLE (le compte n'est jamais supprimé), prisma/sql/076
  statut             String    @default("ACTIF")
  revoqueLe          DateTime? @map("revoque_le") @db.Timestamptz(6)
  revoquePar         String?   @map("revoque_par") @db.Uuid
  revoqueMotif       String?   @map("revoque_motif")

  organisation          Organisation?          @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sousRole              SousRole?              @relation(fields: [role], references: [code], onDelete: NoAction, onUpdate: NoAction)
  adherent              Adherent?              @relation(fields: [adherentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membresComite         MembreComiteGestion[]
  avenantsCrees         Avenant[]
  questionnairesValides QuestionnaireMedical[]
  invitationsEmises     Invitation[]
  actesHomologues       ReferentielActe[]
  medicamentsHomologues Medicament[]
  dossiersClotures      DossierSoins[]
  consultations         ConsultationDossier[]
  ordonnancesPrescrites Ordonnance[]
  actesPrescrits        ActeDossier[]
  facturesReglees       FactureDossier[]
  verificationsReseau   VerificationEtablissement[]
  dispensationsPreparees DispensationPharmacie[]
  substitutionsMedicament LigneDispensation[]
  facturesMensuellesValidees FactureMensuellePharmacie[] @relation("FactureMensuelleValidee")
  autorisationsRepetitionAccordees AutorisationRepetitionActe[]
  notesRedigees NoteDossier[]
  contestationsOuvertes ContestationPrescription[] @relation("ContestationOuvertePar")
  contestationsTraitees ContestationPrescription[] @relation("ContestationTraiteePar")
  contestationsActeOuvertes ContestationActe[] @relation("ContestationActeOuvertePar")
  contestationsActeTraitees ContestationActe[] @relation("ContestationActeTraiteePar")
  facturesMensuellesEtablissementVerifiees FactureMensuelleEtablissement[] @relation("FactureMensuelleEtablissementVerifiee")
  comptesFinanciersCrees CompteFinancier[]
  mouvementsFinanciersEffectues MouvementFinancier[]
  adherentsValides Adherent[] @relation("AdherentValidePar")
  importsAdherentsImportes ImportAdherents[] @relation("ImportAdherentsImportePar")
  importsAdherentsValides  ImportAdherents[] @relation("ImportAdherentsValidePar")
  importsCatalogueNationalImportes ImportCatalogueNational[] @relation("ImportCatalogueNationalImportePar")
  importsCatalogueNationalValides  ImportCatalogueNational[] @relation("ImportCatalogueNationalValidePar")

  @@map("profils")
}

/// souscripteurs — table unifiée, 3 segments (v9 §1.2).
model Souscripteur {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId         String    @map("organisation_id") @db.Uuid
  type                   String // ENTREPRISE | COLLECTIVITE | INDIVIDUEL
  nom                    String
  secteurActivite        String?   @map("secteur_activite")
  effectifDeclare        Int?      @map("effectif_declare")
  typeCollectivite       String?   @map("type_collectivite")
  organeGouvernance      String?   @map("organe_gouvernance")
  subventionExterne      Boolean   @default(false) @map("subvention_externe")
  bailleurSubvention     String?   @map("bailleur_subvention")
  numeroPieceIdentite    String?   @map("numero_piece_identite")
  questionnaireMedicalId String?   @map("questionnaire_medical_id") @db.Uuid
  /// ACTIF | ARCHIVE — archivage RÉVERSIBLE, distinct de `deleted_at` (prisma/sql/075, ADR-007)
  statut                 String    @default("ACTIF")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation           Organisation               @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membresComite          MembreComiteGestion[]
  polices                Police[]
  grillesTarifaires      GrilleTarifaire[]
  planPaiement           PlanPaiementCollectivite[]
  cotisations            Cotisation[]
  questionnairesMedicaux QuestionnaireMedical[]
  adherents              Adherent[]
  importsAdherents       ImportAdherents[]

  @@index([organisationId])
  @@index([type])
  @@index([deletedAt])
  @@map("souscripteurs")
}

/// adherents — personne physique assurée (titulaire). v9 phase 3, PROMPT 12.
/// `numero_adherent` / `numero_carte` générés en base (séquences). prisma/sql/022.
model Adherent {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  souscripteurId      String    @map("souscripteur_id") @db.Uuid
  policeId            String?   @map("police_id") @db.Uuid
  numeroAdherent      String    @unique @default(dbgenerated("(('ADH-'::text || to_char(now(), 'YYYY'::text)) || '-'::text || lpad((nextval('adherents_numero_seq'::regclass))::text, 6, '0'::text))")) @map("numero_adherent")
  nom                 String
  prenom              String
  dateNaissance       DateTime  @map("date_naissance") @db.Date
  /// Nullable depuis prisma/sql/053 : l'import Excel en masse (`ImportAdherentsService`)
  /// ne collecte pas ce champ (colonnes nom/prénom/téléphone/email/date de
  /// naissance uniquement) — reste requis pour la création manuelle (`CreateAdherentDto`).
  sexe                String? // M | F
  /// PROPOSE_SORTANT ajouté (prisma/sql/056) : mouvement de sortie proposé par
  /// SOCIETE_ADMINISTRATION (`proposerSortants`), effectif (SUSPENDU/RADIE,
  /// `statutSortantCible`) seulement après validation ASSUREUR_EXPLOITATION/
  /// INFORMATIQUE (`validerSortants`) — immédiat, aucun report au mois suivant
  /// (seuls les entrants le sont, cf. `ImportAdherents.moisEffet`).
  statut              String    @default("ACTIF")
  /// Renseigné uniquement pendant `statut = 'PROPOSE_SORTANT'` (contrainte
  /// `adherents_sortant_coherent`) — SUSPENDU ou RADIE, choisi à la proposition.
  statutSortantCible  String?   @map("statut_sortant_cible")
  /// Motif de sortie — saisi à la proposition, conservé après validation
  /// comme trace historique (jamais réinitialisé).
  motifSortie         String?   @map("motif_sortie")
  numeroCarte         String    @unique @default(dbgenerated("('CM-'::text || lpad((nextval('cartes_membre_numero_seq'::regclass))::text, 10, '0'::text))")) @map("numero_carte")
  /// Chemin de stockage (bucket privé `photos`, prisma/sql/055) — jamais une
  /// URL signée (éphémère) : résolue à la demande via `obtenirPhotoAdherent`.
  /// Modifiable directement par l'adhérent lui-même, sans validation (donnée
  /// non structurante).
  photoUrl            String?   @map("photo_url")
  /// Import Excel en masse (prisma/sql/053) — unique quand renseigné (nombreux
  /// adhérents existants n'en ont pas). Vérifié en doublon AVANT la création
  /// (ImportAdherentsService), jamais silencieusement écrasé.
  email               String?   @unique
  telephone           String?
  ibanOuRib           String?   @map("iban_ou_rib")
  banqueNom           String?   @map("banque_nom")
  modePaiementPrefere String?   @map("mode_paiement_prefere") // MOBILE_MONEY | VIREMENT_BANCAIRE
  /// Validation par ASSUREUR_EXPLOITATION (prisma/sql/052) — gouverne la
  /// coupure de facturation mensuelle (`BillingService.genererCotisationsPeriode`) :
  /// seul un adhérent PRINCIPAL déjà validé avant le 1er du mois entre dans la
  /// facturation de ce mois. Jamais renseigné pour un `Beneficiaire` (pas de
  /// coupure sur les bénéficiaires — ajout pris en compte immédiatement).
  dateValidation      DateTime? @map("date_validation") @db.Timestamptz(6)
  valideParId         String?   @map("valide_par_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation      Organisation       @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  souscripteur      Souscripteur       @relation(fields: [souscripteurId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  police            Police?            @relation(fields: [policeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  validePar         Profil?            @relation("AdherentValidePar", fields: [valideParId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  beneficiaires     Beneficiaire[]
  profils           Profil[]
  cotisations       Cotisation[]
  invitations       Invitation[]
  dossiersSoins     DossierSoins[]
  codesConsultation CodeConsultation[]
  codesOrdonnance   CodeOrdonnance[]
  facturesDossier   FactureDossier[]
  reclamations      Reclamation[]

  @@index([organisationId])
  @@index([souscripteurId])
  @@index([policeId])
  @@index([statut])
  @@index([deletedAt])
  @@map("adherents")
}

/// imports_adherents — import en masse depuis un fichier Excel (.xlsx) pour
/// une société déjà créée avec sa police/formule (`ImportAdherentsService`,
/// prisma/sql/053). N'AUCUN adhérent n'est créé à l'import : `lignesValides`
/// porte les lignes déjà validées (format, email non dupliqué) en attente de
/// `validerImportAdherents` — seul ce second appel crée les `Adherent` réels
/// et leurs cartes. `erreursDetail` liste précisément chaque ligne rejetée
/// sans jamais bloquer l'import des lignes valides.
model ImportAdherents {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  souscripteurId  String    @map("souscripteur_id") @db.Uuid
  /// Null pour un brouillon de propositions société (prisma/sql/054) — pas de
  /// fichier, les lignes sont ajoutées une à une via `proposerAdherent`/
  /// `proposerBeneficiaire`.
  fichierNom      String?   @map("fichier_nom")
  statut          String    @default("EN_ATTENTE_VALIDATION") // BROUILLON | EN_ATTENTE_VALIDATION | VALIDE | REJETE
  nbLignesTotal   Int       @map("nb_lignes_total")
  nbLignesValides Int       @map("nb_lignes_valides")
  nbLignesErreur  Int       @map("nb_lignes_erreur")
  /// Lignes déjà validées — array JSON discriminé par `type` :
  /// `{type:'ADHERENT', nom, prenom, telephone, email, dateNaissance}` ou
  /// `{type:'BENEFICIAIRE', adherentId, adherentNom, lienParente, nom, prenom,
  /// dateNaissance, sexe}` — consommées (créées en `Adherent`/`Beneficiaire`)
  /// une seule fois, à `validerImportAdherents`. Modifiables ligne par ligne
  /// (`modifierPropositionAdherent`/`Beneficiaire`, `supprimerProposition`)
  /// tant que `statut = 'BROUILLON'` (propositions société uniquement — un
  /// import Excel de l'informatique saute directement en EN_ATTENTE_VALIDATION,
  /// jamais BROUILLON).
  lignesValides   Json      @map("lignes_valides")
  /// Array JSON {ligne, donnees, erreurs[]} — une entrée par ligne rejetée.
  erreursDetail   Json      @map("erreurs_detail")
  importeParId    String    @map("importe_par") @db.Uuid
  valideParId     String?   @map("valide_par") @db.Uuid
  dateValidation  DateTime? @map("date_validation") @db.Timestamptz(6)
  /// Suppression logique d'un brouillon de propositions (prisma/sql/077)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// Mouvements de personnel à effet différé (prisma/sql/056) : mois auquel
  /// les ADHERENT de ce lot doivent devenir éligibles à la facturation (1er du
  /// mois). Quand renseigné, `validerImportAdherents` stampe directement
  /// `Adherent.dateValidation` à la veille de ce mois (jamais `now()`) —
  /// garantit le mois d'effet promis à la proposition, même si la validation
  /// assureur est tardive. `null` pour tout import/proposition sans effet
  /// différé (comportement historique inchangé : la coupure de facturation
  /// reste gouvernée par `AdherentService.validerAdherent`, appelé séparément).
  moisEffet       DateTime? @map("mois_effet") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  souscripteur Souscripteur @relation(fields: [souscripteurId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  importePar   Profil       @relation("ImportAdherentsImportePar", fields: [importeParId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  validePar    Profil?      @relation("ImportAdherentsValidePar", fields: [valideParId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organisationId])
  @@index([souscripteurId])
  @@index([statut])
  @@map("imports_adherents")
}

/// beneficiaires — ayants droit rattachés à un adhérent titulaire. prisma/sql/022.
model Beneficiaire {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adherentId    String    @map("adherent_id") @db.Uuid
  lienParente   String    @map("lien_parente") // CONJOINT | ENFANT | PERE | MERE | AUTRE
  nom           String
  prenom        String
  dateNaissance DateTime  @map("date_naissance") @db.Date
  sexe          String // M | F
  /// Nullable depuis prisma/sql/055 : NULL tant qu'un bénéficiaire proposé par
  /// l'adhérent lui-même n'a pas franchi les DEUX validations (statut
  /// EN_ATTENTE_SOCIETE → EN_ATTENTE_ASSUREUR → ACTIF, qui attribue le numéro à
  /// ce moment précis, jamais avant). Toujours généré immédiatement pour une
  /// création directe par SOCIETE_ADMINISTRATION/ASSUREUR (défaut inchangé).
  numeroCarte   String?   @unique @default(dbgenerated("('CM-'::text || lpad((nextval('cartes_membre_numero_seq'::regclass))::text, 10, '0'::text))")) @map("numero_carte")
  /// EN_ATTENTE_SOCIETE | EN_ATTENTE_ASSUREUR (circuit de proposition par
  /// l'adhérent, prisma/sql/055) | ACTIF | SUSPENDU | RADIE.
  statut        String    @default("ACTIF")
  /// Chemin de stockage (bucket privé `photos`) — voir `Adherent.photoUrl`.
  /// Modifiable par l'adhérent (sa propre photo ou celle d'un bénéficiaire),
  /// sans validation, y compris pendant la double validation en cours.
  photoUrl      String?   @map("photo_url")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  adherent          Adherent           @relation(fields: [adherentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  dossiersSoins     DossierSoins[]
  codesConsultation CodeConsultation[]
  codesOrdonnance   CodeOrdonnance[]
  facturesDossier   FactureDossier[]
  reclamations      Reclamation[]

  @@index([adherentId])
  @@index([statut])
  @@map("beneficiaires")
}

/// membres_comite_gestion — gouvernance des collectivités (v9 §1.3).
model MembreComiteGestion {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  souscripteurId  String    @map("souscripteur_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  fonction        String
  dateDebutMandat DateTime  @default(dbgenerated("CURRENT_DATE")) @map("date_debut_mandat") @db.Date
  dateFinMandat   DateTime? @map("date_fin_mandat") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  souscripteur Souscripteur @relation(fields: [souscripteurId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profil       Profil       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([souscripteurId])
  @@index([userId])
  @@map("membres_comite_gestion")
}

/// regles_provisioning — qui peut créer/proposer quel sous-rôle (v9 §1.4 / §1.5). prisma/sql/003.
model RegleProvisioning {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleCreateur   String    @map("role_createur")
  roleCree       String    @map("role_cree")
  scopeVerifie   String?   @map("scope_verifie")
  mode           String    @default("CREATION_DIRECTE") // CREATION_DIRECTE | PROPOSITION
  roleValidateur String?   @map("role_validateur")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  createur   SousRole  @relation("RegleCreateur", fields: [roleCreateur], references: [code], onDelete: NoAction, onUpdate: NoAction)
  cree       SousRole  @relation("RegleCree", fields: [roleCree], references: [code], onDelete: NoAction, onUpdate: NoAction)
  validateur SousRole? @relation("RegleValidateur", fields: [roleValidateur], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roleCreateur, roleCree], map: "regles_provisioning_unique")
  @@index([roleCreateur])
  @@index([roleCree])
  @@map("regles_provisioning")
}

/// categories_acte — référentiel UNIQUE des catégories d'acte (prisma/sql/067) :
/// garanties, actes de dossier, référentiels d'actes, type de réclamation et
/// rôle de revue manuelle. Lecture seule hors migration.
/// conventions — convention d'un établissement avec l'assureur (prisma/sql/081, ADR-008) : période, document signé,
/// circuit PROPOSEE → VALIDEE | REFUSEE, ARCHIVEE ; jamais validée par la personne qui l'a saisie.
model Convention {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId         String    @map("organisation_id") @db.Uuid
  etablissementId        String    @map("etablissement_id") @db.Uuid
  numero                 String
  version                Int       @default(1)
  conventionPrecedenteId String?   @map("convention_precedente_id") @db.Uuid
  dateDebut              DateTime  @map("date_debut") @db.Date
  dateFin                DateTime? @map("date_fin") @db.Date
  statut                 String    @default("PROPOSEE") // PROPOSEE | VALIDEE | REFUSEE | ARCHIVEE
  politiqueDepassement   String    @default("PATIENT") @map("politique_depassement") // PATIENT | REJET
  documentChemin         String?   @map("document_chemin")
  documentNom            String?   @map("document_nom")
  documentType           String?   @map("document_type")
  /// Convention créée par la migration des anciens tarifs d'établissement (aucune saisie, aucun validateur)
  historique             Boolean   @default(false)
  saisiPar               String?   @map("saisi_par") @db.Uuid
  dateSaisie             DateTime  @default(now()) @map("date_saisie") @db.Timestamptz(6)
  modifiePar             String?   @map("modifie_par") @db.Uuid
  validePar              String?   @map("valide_par") @db.Uuid
  dateValidation         DateTime? @map("date_validation") @db.Timestamptz(6)
  refusePar              String?   @map("refuse_par") @db.Uuid
  dateRefus              DateTime? @map("date_refus") @db.Timestamptz(6)
  motifRefus             String?   @map("motif_refus")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  etablissement EtablissementSante @relation(fields: [etablissementId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  precedente    Convention?        @relation("VersionsConvention", fields: [conventionPrecedenteId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  suivantes     Convention[]       @relation("VersionsConvention")
  valeurs       ConventionValeur[]
  actes         ConventionActe[]
  lignesFacturation LigneFacturation[]

  @@index([etablissementId, statut])
  @@index([organisationId, statut])
  @@map("conventions")
}

/// convention_valeurs — valeur en FCFA d'une lettre-clé, par contexte (prisma/sql/081).
model ConventionValeur {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conventionId    String    @map("convention_id") @db.Uuid
  lettreCleCode   String    @map("lettre_cle_code")
  contexte        String // AMBULATOIRE | HOSPITALISATION
  valeur          Decimal   @db.Decimal(14, 2)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  convention Convention @relation(fields: [conventionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lettreCle  LettreCle  @relation(fields: [lettreCleCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@index([conventionId])
  @@map("convention_valeurs")
}

/// convention_actes — exception par acte : forfait OU valeur de lettre-clé propre à l'acte (prisma/sql/081).
/// L'identifiant d'une ligne migrée est celui de l'ancien tarif conventionné.
model ConventionActe {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conventionId      String    @map("convention_id") @db.Uuid
  referentielActeId String    @map("referentiel_acte_id") @db.Uuid
  prixForfaitaire   Decimal?  @map("prix_forfaitaire") @db.Decimal(14, 2)
  valeurLettreCle   Decimal?  @map("valeur_lettre_cle") @db.Decimal(14, 2)
  dateDebut         DateTime? @map("date_debut") @db.Date
  dateFin           DateTime? @map("date_fin") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  convention      Convention      @relation(fields: [conventionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  referentielActe ReferentielActe @relation(fields: [referentielActeId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([conventionId])
  @@index([referentielActeId])
  @@map("convention_actes")
}

/// lettres_cles — référentiel paramétrable des lettres-clés de la nomenclature (prisma/sql/080), géré par le
/// superadmin. Aucune valeur chiffrée : les valeurs en FCFA se négocient par établissement.
model LettreCle {
  code       String   @id
  id         String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  libelle    String
  actif      Boolean  @default(true)
  ordre      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  conventionValeurs ConventionValeur[]
  actesNationaux ReferentielNationalActe[]
  actes          ReferentielActe[]

  @@map("lettres_cles")
}

model CategorieActe {
  code            String     @id
  libelle         String
  typeReclamation String     @map("type_reclamation") // SOIN | PHARMACIE | HOSPITALISATION | OPTIQUE | DENTAIRE | ANALYSES | IMAGERIE | AUTRE
  roleRevue       String     @map("role_revue") // FK sous_roles.code
  actif           Boolean    @default(true)
  ordre           Int        @default(0)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  actesNationauxGarantie ReferentielNationalActe[] @relation("ReferentielNationalActeCategorieGarantie")
  actesGarantie          ReferentielActe[]         @relation("ReferentielActeCategorieGarantie")
  garanties Garantie[]
  actes     ActeDossier[]

  @@map("categories_acte")
}

/// produits — formule d'assurance VERSIONNÉE (v9 phase 2.1 / v3 §2). prisma/sql/004.
model Produit {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  nom             String
  version         Int       @default(1)
  statut          String    @default("BROUILLON") // BROUILLON | PUBLIE | ARCHIVE
  datePublication DateTime? @map("date_publication") @db.Timestamptz(6)
  /// Catégories d'acte confirmées NON COUVERTES par l'assureur à la publication
  /// (aucune garantie) — prisma/sql/067. Codes de `categories_acte`.
  categoriesNonCouvertes String[] @default([]) @map("categories_non_couvertes")
  /// Période de cumul des plafonds annuels (prisma/sql/069) : ANNEE_POLICE (défaut,
  /// anniversaire de la police) | ANNEE_CIVILE. Produits antérieurs à 069 : ANNEE_CIVILE.
  periodeCumulPlafond String @default("ANNEE_POLICE") @map("periode_cumul_plafond")
  /// Jours après la fin de la police pendant lesquels des soins reçus pendant la
  /// couverture peuvent encore être déclarés (prisma/sql/071). Défaut 90 ; 0 = aucun.
  delaiDeclarationJours Int @default(90) @map("delai_declaration_jours")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation      Organisation      @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  garanties         Garantie[]
  polices           Police[]
  grillesTarifaires GrilleTarifaire[]

  // (organisation, nom, version) unique parmi les non supprimés : index partiel (prisma/sql/074)
  @@index([organisationId])
  @@index([organisationId, nom], map: "produits_org_nom_idx")
  @@index([statut])
  @@index([deletedAt])
  @@map("produits")
}

/// garanties — lignes de couverture d'un produit. Montants en Decimal.
model Garantie {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  produitId         String    @map("produit_id") @db.Uuid
  categorieActe     String    @map("categorie_acte") // FK categories_acte.code (prisma/sql/067)
  tauxCouverture    Decimal   @map("taux_couverture") @db.Decimal(5, 2) // obligatoire depuis prisma/sql/067
  plafondParActe    Decimal?  @map("plafond_par_acte") @db.Decimal(14, 2)
  /// Plafonds annuels (prisma/sql/069), chacun optionnel — le plus restrictif s'applique :
  /// par personne assurée, et partagé par la famille (titulaire + bénéficiaires).
  plafondAnnuelPersonne Decimal? @map("plafond_annuel_personne") @db.Decimal(14, 2)
  plafondAnnuelFamille  Decimal? @map("plafond_annuel_famille") @db.Decimal(14, 2)
  franchise         Decimal?  @db.Decimal(14, 2)
  ticketModerateur  Decimal?  @map("ticket_moderateur") @db.Decimal(5, 2)
  delaiCarenceJours Int?      @map("delai_carence_jours")
  reseauSoins       String    @default("TOUT_RESEAU") @map("reseau_soins") // CONVENTIONNE_SEUL | TOUT_RESEAU
  exclusions        String[]  @default([])
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  produit       Produit        @relation(fields: [produitId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  categorie     CategorieActe  @relation(fields: [categorieActe], references: [code], onDelete: NoAction, onUpdate: NoAction)
  dossiersSoins DossierSoins[]
  reclamations  Reclamation[]

  // + index unique partiel (produit_id, categorie_acte) WHERE deleted_at IS NULL
  //   (garanties_produit_categorie_unique, prisma/sql/067 — non exprimable ici)
  @@index([produitId])
  @@map("garanties")
}

/// polices — contrat. Machine à états stricte (PolicyService). Produit PUBLIE requis. prisma/sql/005.
model Police {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  souscripteurId String    @map("souscripteur_id") @db.Uuid
  produitId      String    @map("produit_id") @db.Uuid
  numeroPolice   String    @unique @default(dbgenerated("((('POL-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('polices_numero_seq'::regclass))::text, 6, '0'::text))")) @map("numero_police")
  dateDebut      DateTime? @map("date_debut") @db.Date
  dateFin        DateTime? @map("date_fin") @db.Date
  statut         String    @default("DEVIS") // DEVIS | EN_SOUSCRIPTION | ACTIVE | SUSPENDUE | RENOUVELEE | RESILIEE | NON_RENOUVELEE
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation      Organisation               @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  souscripteur      Souscripteur               @relation(fields: [souscripteurId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produit           Produit                    @relation(fields: [produitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  avenants          Avenant[]
  cotisations       Cotisation[]
  tarifications     TarificationIndividuelle[]
  dossiersSoins     DossierSoins[]
  codesConsultation CodeConsultation[]
  adherents         Adherent[]

  @@index([organisationId])
  @@index([souscripteurId])
  @@index([produitId])
  @@index([statut])
  @@index([deletedAt])
  @@map("polices")
}

/// avenants — modifications contractuelles d'une police. prisma/sql/005.
model Avenant {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policeId               String    @map("police_id") @db.Uuid
  type                   String // AJOUT_ADHERENT | RADIATION_ADHERENT | CHANGEMENT_FORMULE | AJOUT_BENEFICIAIRE | MODIFICATION_TARIFAIRE | RESILIATION
  dateEffet              DateTime  @map("date_effet") @db.Date
  dateCreation           DateTime  @default(now()) @map("date_creation") @db.Timestamptz(6)
  creePar                String?   @map("cree_par") @db.Uuid
  proratisationAppliquee Boolean   @default(false) @map("proratisation_appliquee")
  impactCotisation       Decimal?  @map("impact_cotisation") @db.Decimal(14, 2)
  statut                 String    @default("BROUILLON") // BROUILLON | APPLIQUE | ANNULE
  /// Annulation d'un avenant APPLIQUE : motif obligatoire, jamais de suppression (prisma/sql/077)
  motifAnnulation        String?   @map("motif_annulation")
  annuleLe               DateTime? @map("annule_le") @db.Timestamptz(6)
  annulePar              String?   @map("annule_par") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  police        Police  @relation(fields: [policeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  creeParProfil Profil? @relation(fields: [creePar], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([policeId])
  @@index([statut])
  @@map("avenants")
}

/// grilles_tarifaires — tarif par tranche d'âge (v9 phase 2.6). souscripteur_id null =
/// STANDARD, renseigné = NÉGOCIÉ (prioritaire). prisma/sql/006.
model GrilleTarifaire {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  produitId      String    @map("produit_id") @db.Uuid
  trancheAgeMin  Int       @map("tranche_age_min")
  trancheAgeMax  Int       @map("tranche_age_max")
  souscripteurId String?   @map("souscripteur_id") @db.Uuid
  montantMensuel Decimal   @map("montant_mensuel") @db.Decimal(14, 2)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produit      Produit       @relation(fields: [produitId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  souscripteur Souscripteur? @relation(fields: [souscripteurId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  cotisations              Cotisation[]
  tarificationsIndividuelles TarificationIndividuelle[]

  @@index([produitId])
  @@index([souscripteurId])
  @@map("grilles_tarifaires")
}

/// plan_paiement_collectivite — modalités de paiement d'une COLLECTIVITE (v9 §2.2). prisma/sql/006.
model PlanPaiementCollectivite {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  souscripteurId         String    @map("souscripteur_id") @db.Uuid
  periodicite            String // MENSUELLE | TRIMESTRIELLE | SAISONNIERE | ANNUELLE
  partMembrePourcent     Decimal   @default(100) @map("part_membre_pourcent") @db.Decimal(5, 2)
  partSubventionPourcent Decimal   @default(0) @map("part_subvention_pourcent") @db.Decimal(5, 2)
  echeances              Json?
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  souscripteur Souscripteur @relation(fields: [souscripteurId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("plan_paiement_collectivite")
}

/// cotisations — appels de cotisation. adherent_id XOR societe_id (CHECK). prisma/sql/006.
model Cotisation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policeId          String    @map("police_id") @db.Uuid
  adherentId        String?   @map("adherent_id") @db.Uuid
  societeId         String?   @map("societe_id") @db.Uuid
  periode           DateTime  @db.Date
  montantDu         Decimal   @map("montant_du") @db.Decimal(14, 2)
  montantPaye       Decimal   @default(0) @map("montant_paye") @db.Decimal(14, 2)
  dateEcheance      DateTime  @map("date_echeance") @db.Date
  statut            String    @default("A_PAYER") // A_PAYER | PAYEE | EN_RETARD | ANNULEE
  penaliteAppliquee Decimal   @default(0) @map("penalite_appliquee") @db.Decimal(14, 2)
  /// grille ayant servi au calcul (cotisation individuelle ; null pour une facture société consolidée) — prisma/sql/074
  grilleTarifaireId String?   @map("grille_tarifaire_id") @db.Uuid
  /// Annulation (A_PAYER sans paiement) : motif obligatoire, jamais de suppression (prisma/sql/077)
  motifAnnulation   String?   @map("motif_annulation")
  annuleeLe         DateTime? @map("annulee_le") @db.Timestamptz(6)
  annuleePar        String?   @map("annulee_par") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  police   Police        @relation(fields: [policeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  societe  Souscripteur? @relation(fields: [societeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grilleTarifaire GrilleTarifaire? @relation(fields: [grilleTarifaireId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  adherent Adherent?     @relation(fields: [adherentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([policeId])
  @@index([statut])
  @@index([dateEcheance])
  @@map("cotisations")
}

/// questionnaires_medicaux — évaluation médicale à la souscription INDIVIDUELLE
/// (v4 §3.1, v10 §3). SÉPARATION STRICTE : décision réservée à
/// ASSUREUR_MEDECIN_SOUSCRIPTEUR ; ASSUREUR_MEDECIN_CONSEIL n'a AUCUN accès.
/// `decision` null tant que non traité. prisma/sql/007.
model QuestionnaireMedical {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  souscripteurId        String    @map("souscripteur_id") @db.Uuid
  reponses              Json      @default("{}")
  antecedentsDeclares   String[]  @default([]) @map("antecedents_declares")
  dateSoumission        DateTime? @map("date_soumission") @db.Timestamptz(6)
  decision              String? // ACCEPTE | ACCEPTE_AVEC_EXCLUSION | ACCEPTE_SURPRIME | REFUSE
  exclusionsSpecifiques String[]  @default([]) @map("exclusions_specifiques")
  surprimePourcent      Decimal   @default(0) @map("surprime_pourcent") @db.Decimal(6, 2)
  validePar             String?   @map("valide_par") @db.Uuid
  dateDecision          DateTime? @map("date_decision") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  souscripteur  Souscripteur               @relation(fields: [souscripteurId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  validateur    Profil?                    @relation(fields: [validePar], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tarifications TarificationIndividuelle[]

  @@index([souscripteurId])
  @@index([decision])
  @@map("questionnaires_medicaux")
}

/// tarification_individuelle — prime individuelle = prime_base + surprime_medicale
/// (colonne `prime_finale` GENERATED ALWAYS AS ... STORED — ne pas écrire). prisma/sql/007.
model TarificationIndividuelle {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policeId               String   @map("police_id") @db.Uuid
  questionnaireMedicalId String   @map("questionnaire_medical_id") @db.Uuid
  ageASubscription       Int      @map("age_a_souscription")
  primeBase              Decimal  @map("prime_base") @db.Decimal(14, 2)
  surprimeMedicale       Decimal  @default(0) @map("surprime_medicale") @db.Decimal(14, 2)
  primeFinale            Decimal? @map("prime_finale") @db.Decimal(14, 2) // GENERATED — lecture seule
  /// grille standard ayant servi au calcul de la prime — prisma/sql/074
  grilleTarifaireId      String?  @map("grille_tarifaire_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  police        Police               @relation(fields: [policeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  questionnaire QuestionnaireMedical @relation(fields: [questionnaireMedicalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grilleTarifaire GrilleTarifaire?   @relation(fields: [grilleTarifaireId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([policeId])
  @@index([questionnaireMedicalId], map: "tarification_individuelle_questionnaire_id_idx")
  @@map("tarification_individuelle")
}

/// invitations — flux d'invitation sécurisé (v5 §3, PROMPT 6). L'invité définit
/// lui-même son mot de passe ; il n'est jamais généré ni vu côté serveur.
/// mode = PROPOSITION → statut EN_ATTENTE_VALIDATION_INFORMATIQUE jusqu'à
/// validation par `roleValidateur`. prisma/sql/008.
model Invitation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String
  telephone       String?
  rolePropose     String    @map("role_propose")
  organisationId  String?   @map("organisation_id") @db.Uuid
  societeId       String?   @map("societe_id") @db.Uuid
  etablissementId String?   @map("etablissement_id") @db.Uuid
  pharmacieId     String?   @map("pharmacie_id") @db.Uuid
  adherentId      String?   @map("adherent_id") @db.Uuid
  invitePar       String    @map("invite_par") @db.Uuid
  token           String    @unique
  statut          String    @default("EN_ATTENTE") // EN_ATTENTE_VALIDATION_INFORMATIQUE | EN_ATTENTE | ACCEPTEE | REJETEE | EXPIREE | REVOQUEE
  mode            String    @default("CREATION_DIRECTE") // CREATION_DIRECTE | PROPOSITION
  roleValidateur  String?   @map("role_validateur")
  authUserId      String?   @map("auth_user_id") @db.Uuid
  motifRejet      String?   @map("motif_rejet")
  /// NULL = aucun essai d'envoi réel encore tenté (proposition en attente,
  /// ou ligne historique antérieure à cette colonne).
  emailEnvoye     Boolean?  @map("email_envoye")
  /// Invitation qui remplace celle-ci (révoquée ou expirée) — l'ancienne reste dans l'historique (076)
  remplaceePar    String?   @map("remplacee_par") @db.Uuid
  expireLe        DateTime  @default(dbgenerated("(now() + '72:00:00'::interval)")) @map("expire_le") @db.Timestamptz(6)
  accepteLe       DateTime? @map("accepte_le") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  emetteur     Profil        @relation(fields: [invitePar], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adherent     Adherent?     @relation(fields: [adherentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([invitePar])
  @@index([statut])
  @@map("invitations")
}

/// etablissements_sante — réseau de soins (entité d'affichage CENTRE_MEDICAL,
/// v9 §1.1). Écriture réservée à ASSUREUR_INFORMATIQUE. prisma/sql/009.
model EtablissementSante {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  nom               String
  code              String // unique parmi les non supprimés : index partiel (prisma/sql/074)
  typeEtablissement String    @map("type_etablissement") // HOPITAL_PUBLIC | CLINIQUE_PRIVEE | CABINET_MEDICAL | CENTRE_SANTE | LABORATOIRE | CENTRE_IMAGERIE | OPTICIEN | DENTISTE | MATERNITE
  pays              String    @default("Côte d'Ivoire")
  ville             String?
  commune           String?
  quartier          String?
  adresseComplete   String?   @map("adresse_complete")
  latitude          Float?
  longitude         Float?
  telephone         String?
  telephoneUrgence  String?   @map("telephone_urgence")
  email             String?
  statut            String    @default("EN_ATTENTE_VALIDATION") // ACTIF | SUSPENDU | EN_ATTENTE_VALIDATION | RESILIE
  /// @deprecated (prisma/sql/081) : la période de validité vient de la table `conventions`
  dateConvention    DateTime? @map("date_convention") @db.Date
  /// @deprecated (prisma/sql/081) : voir `conventions`
  dateFinConvention DateTime? @map("date_fin_convention") @db.Date
  gardeWeekend      Boolean   @default(false) @map("garde_weekend")
  horairesGarde     Json?     @map("horaires_garde")
  horairesSemaine   Json?     @map("horaires_semaine")
  tiersPayant       Boolean   @default(true) @map("tiers_payant")
  verificationStatut       String?   @map("verification_statut") // ACTIF | FERME | DEMENAGE | A_REVERIFIER
  dateDerniereVerification DateTime? @map("date_derniere_verification") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation       Organisation       @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dossiers           DossierSoins[]     @relation("DossierEtablissement")
  dossiersTransferes DossierSoins[]     @relation("DossierTransfereVers")
  codesConsultation  CodeConsultation[]
  factures           FactureDossier[]
  verifications      VerificationEtablissement[]
  conventions         Convention[]
  tarifsConventionnes TarifConventionne[]
  actesExecutes      ActeDossier[]      @relation("ActeEtablissementExecution")
  facturesMensuelles FactureMensuelleEtablissement[]

  @@index([organisationId])
  @@index([statut])
  @@index([verificationStatut])
  @@map("etablissements_sante")
}

/// pharmacies — réseau de soins (entité PHARMACIE). Écriture réservée à
/// ASSUREUR_INFORMATIQUE. prisma/sql/009.
model Pharmacie {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  nom               String
  code              String // unique parmi les non supprimés : index partiel (prisma/sql/074)
  pays              String    @default("Côte d'Ivoire")
  ville             String?
  commune           String?
  quartier          String?
  adresseComplete   String?   @map("adresse_complete")
  latitude          Float?
  longitude         Float?
  telephone         String?
  email             String?
  statut            String    @default("ACTIVE") // ACTIVE | SUSPENDUE | RESILIEE
  gardeWeekend      Boolean   @default(false) @map("garde_weekend")
  horairesGarde     Json?     @map("horaires_garde")
  tiersPayant       Boolean   @default(true) @map("tiers_payant")
  dateConvention    DateTime? @map("date_convention") @db.Date
  dateFinConvention DateTime? @map("date_fin_convention") @db.Date
  verificationStatut       String?   @map("verification_statut") // ACTIF | FERME | DEMENAGE | A_REVERIFIER
