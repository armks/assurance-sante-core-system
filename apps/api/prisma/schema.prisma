model VerificationEtablissement {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  etablissementId  String?  @map("etablissement_id") @db.Uuid
  pharmacieId      String?  @map("pharmacie_id") @db.Uuid
  dateVerification DateTime @default(now()) @map("date_verification") @db.Timestamptz(6)
  methode          String // APPEL_TELEPHONIQUE | VISITE_TERRAIN | AUTO_DECLARATIF
