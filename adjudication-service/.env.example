# Copier en `.env` (gitignoré) et renseigner les vraies valeurs.
# Le microservice lit ces variables d'environnement (jamais de secret en dur / versionné).

# URL JDBC Postgres (Supabase : pooler session mode, port 5432, sslmode=require)
JDBC_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require

# Rôle technique dédié — via le pooler Supabase : <role>.<project-ref>
JDBC_USER=svc_adjudication.<project-ref>

# Mot de passe du rôle svc_adjudication (défini par `ALTER ROLE svc_adjudication PASSWORD '...'`)
JDBC_PASSWORD=

# Secret HMAC-SHA256 partagé avec l'Edge Function `declencher-adjudication`
# (doit être IDENTIQUE des deux côtés). Le service refuse de démarrer s'il est vide.
SERVICE_JWT_SECRET=

PORT=8899
