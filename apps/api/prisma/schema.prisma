  tarifsConventionnes TarifConventionne[]

  @@index([organisationId])
  @@index([statut])
  @@map("referentiel_actes")
}

/// tarifs_conventionnes — tarif négocié établissement/pharmacie × acte (v3 §5,
/// plan directeur phase 4.2 « Grilles tarifaires conventionnées »). DIFFÉRENT de
/// `grilles_tarifaires` (cotisation par tranche d'âge/souscripteur, PROMPT 11).
/// Utilisé par le microservice d'adjudication : min(montant_facture,
/// tarif_convention) avant application du taux de couverture. prisma/sql/033.
model TarifConventionne {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String    @map("organisation_id") @db.Uuid
  etablissementId    String?   @map("etablissement_id") @db.Uuid
  pharmacieId        String?   @map("pharmacie_id") @db.Uuid
  referentielActeId  String    @map("referentiel_acte_id") @db.Uuid
  tarifConvention    Decimal   @map("tarif_convention") @db.Decimal(14, 2)
  dateDebut          DateTime  @map("date_debut") @db.Date
  dateFin            DateTime? @map("date_fin") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation    Organisation       @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  etablissement   EtablissementSante? @relation(fields: [etablissementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pharmacie       Pharmacie?         @relation(fields: [pharmacieId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referentielActe ReferentielActe    @relation(fields: [referentielActeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organisationId])
  @@index([etablissementId])
  @@index([pharmacieId])
  @@index([referentielActeId])
  @@map("tarifs_conventionnes")
}

/// medicaments — référentiel des médicaments (v3 §9). Passage à HOMOLOGUE réservé
/// à ASSUREUR_PHARMACIEN_CONSEIL (v8 §10.2). prisma/sql/010.
model Medicament {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId        String    @map("organisation_id") @db.Uuid
  denominationCommune   String    @map("denomination_commune")
  nomCommercial         String?   @map("nom_commercial")
  codeEan               String?   @map("code_ean")
  forme                 String?
  dosage                String?
  conditionnement       String?
  classeTherapeutique   String?   @map("classe_therapeutique")
  remboursable          Boolean   @default(false)
  tauxRemboursementStd  Decimal?  @map("taux_remboursement_std") @db.Decimal(5, 2)
  prixReferenceXof      Decimal?  @map("prix_reference_xof") @db.Decimal(14, 2)
  prixMaxRemboursable   Decimal?  @map("prix_max_remboursable") @db.Decimal(14, 2)
  medicamentEssentiel   Boolean   @default(false) @map("medicament_essentiel")
  generiqueDisponible   Boolean?  @map("generique_disponible")
  ordonnanceObligatoire Boolean   @default(true) @map("ordonnance_obligatoire")
  medicamentControle    Boolean   @default(false) @map("medicament_controle")
  usage                 String? // AMBULATOIRE | HOSPITALIER | LES_DEUX
  statutHomologation    String    @default("PROPOSE") @map("statut_homologation") // PROPOSE | HOMOLOGUE | SUSPENDU | RETIRE
  homologuePar          String?   @map("homologue_par") @db.Uuid
  dateHomologation      DateTime? @map("date_homologation") @db.Timestamptz(6)
  dateRetrait           DateTime? @map("date_retrait") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  homologateur Profil?      @relation(fields: [homologuePar], references: [id], onDelete: NoAction, onUpdate: NoAction)

